# ---- Python ----
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
.pytest_cache/

# ---- 构建与打包产物 ----
build/
dist/
installer_output/
# 通用忽略 *.spec，但保留项目正式的打包配置（否则 build_installer.bat 无配置可用）
*.spec
!TCMAI.spec

# ---- 模型权重与缓存 (体积大，不入库) ----
*.safetensors
*.pth
*.pkl
*.msc
*.mv
*.mdl

# ---- 本地工具与运行时产物 ----
.qwen/
logs/
*.log
*.lock
data/font_test.txt
data/kg_test_full.txt

# ---- 用户运行数据（含症状等健康信息，严禁入库）----
data/history.json
data/history.json.corrupt.json
data/logs/
data/ablation_nlu_quant.json

# ---- 凭据与本地配置（严禁入库）----
# 连接信息与口令一律放本地 config.json，模板见 config.example.json。
/config.json
config.local.json
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
settings_local.py
local_settings.py
# HuggingFace 模型自带的 config.json 属模型元数据，必须保留
!models/**/config.json
!**/config.example.json
# Neo4j 本地配置
neo4j.conf
