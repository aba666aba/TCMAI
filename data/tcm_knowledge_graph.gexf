      <node id="herb:斑蝥" label="herb:斑蝥">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="斑蝥" />
          <attvalue for="4" value="372" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="攻毒蚀疮；逐瘀散结。主痈疽；瘰疬；顽癣；经闭；症瘕；癌肿。用于癓瘕肿块，积年顽癣，瘰疬，赘疣，痈疽不溃，恶疮死肌。。①《本经》：主寒热，鼠瘘，恶疮疽，蚀死肌，破石癃。②《别录》：主疥癣，血积，堕胎。③" />
          <attvalue for="7" value="斑蝥：抗肿瘤，破癥散结，攻毒蚀疮。用于肝癌，食道癌，喷门癌，胃癌，肺癌，乳腺，瘰疬，恶疮死肌，顽癣瘙痒。" />
          <attvalue for="8" value="味辛；性温；大毒。" />
          <attvalue for="9" value="辛寒" />
          <attvalue for="10" value="入大肠、小肠、肝、肾经。①《本草经疏》：入手阳明、手太阳经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="有剧毒，内服宜慎；体弱及孕妇忌服。①《本草经集注》：马刀为使。畏巴豆、丹参、空青。恶肤青。②《日华子本草》：恶豆花。入药除翼、足，熟炒用，生即吐泻人。③《本草衍义》：妊身人不可服，为能溃人肉。治淋药多用，极苦人，尤宜斟酌。④《纲目》：恶甘草。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
          <attvalue for="14" value="true" />
        </attvalues>
      </node>
      <node id="herb:穿山甲" label="herb:穿山甲">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="穿山甲" />
          <attvalue for="4" value="373" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="活血散结；通经下乳；消痈溃坚。主血瘀经闭；症瘕；风湿痹痛；乳汁不下；痈肿；瘰疬。用于经闭癓瘕，乳汁不通，痈肿疮毒，关节痹痛，麻木拘挛。①《别录》：主五邪惊啼悲伤，烧之作灰，以酒或水和方寸匕，疗蚁瘘。②" />
          <attvalue for="7" value="穿山甲：消肿溃痈，搜风活络，通经下乳。治痈疽疮种，风寒湿痹，月经停闭，乳汁不通。外用止血。" />
          <attvalue for="8" value="味咸；性微寒。①《别录》：微寒。②《药性" />
          <attvalue for="9" value="咸" />
          <attvalue for="10" value="入肝、胃经。①《纲目》：入厥阴、阳明经。②《本草汇言》：入足" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="气血虚弱、痈疽已溃者及孕妇禁服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
          <attvalue for="14" value="true" />
        </attvalues>
      </node>
      <node id="herb:半夏" label="herb:半夏">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="半夏" />
          <attvalue for="4" value="374" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="燥湿化痰，降逆止呕，消痞散结。治湿痰冷饮，呕吐，反胃，咳喘痰多，胸膈胀满，痰厥头痛，头晕不眠。外消痈肿。用于痰多咳喘、痰饮眩悸、内痰眩晕、呕吐反胃、胸脘痞闷、梅核气症；生用外治痈肿痰核。姜半夏多用于降" />
          <attvalue for="7" value="半夏：燥湿化痰，降逆止呕，消痞散结。治湿痰冷饮，呕吐，反胃，咳喘痰多，胸膈胀满，痰厥头痛，头晕不眠。外消痈肿。" />
          <attvalue for="8" value="辛，温，有毒。①《本经》：辛，平。②《别" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入脾、胃经。①《汤液本草》：入足阳明、太阴、少阳经。②《雷公" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚燥咳、津伤口渴、血证及燥痰者禁服，孕妇慎服。半夏使用不当可引起中毒，表现为口舌咽喉痒痛麻木，声音嘶哑，言语不清，流涎，味觉消失，恶心呕吐，胸闷，腹痛腹泻严重者可出现喉头痉挛，呼吸困难，四肢麻痹，血压下降，肝肾功能损害等，最后可因呼吸中枢麻痹而死亡。①《本草经集注》：射干为之使。恶皂荚。畏雄黄、生姜、干姜、秦皮、龟甲。反乌头。②《药性论》：忌羊血、海藻、饴糖。柴胡为之使。③张元素：诸血证及口渴者" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:天南星" label="herb:天南星">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="天南星" />
          <attvalue for="4" value="375" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="祛风止痉；化痰散结。主中风痰壅；口眼歪任意；半身不遂；手足麻痹；风痰眩晕；癫闲；惊风；破伤风；咳嗽多痰；痈肿；瘰疬；跌打麻痹；毒蛇咬伤。生用外治痈肿、蛇虫咬伤。祛风痰，解痉痫：用于风痰壅盛之中风眩晕、" />
          <attvalue for="7" value="天南星：燥湿化痰，祛风定惊，消肿散结。治中风痰塑，口眼歪斜，半身不遂，癫痫，惊风，破伤风，风痰眩晕，喉痹，瘰疬，痈肿，跌扑折伤，蛇虫咬伤。" />
          <attvalue for="8" value="味苦；辛；性温；有毒。①《本经》：味苦，" />
          <attvalue for="9" value="苦、辛" />
          <attvalue for="10" value="入肺、肝、脾经。①《纲目》：手、足太阴。②《本草通玄》：肺、" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚燥咳，热极、血虚动风者禁服，孕妇慎服。生天南星使用不当易致中毒，症状有口腔粘膜糜烂，甚至坏死脱落，唇舌咽喉麻木肿胀，运动失灵，味觉消失，大量流涎；声音嘶哑，言语不清，发热，头昏，心慌，四肢麻木，严重者可出现昏迷，惊厥；窒息，呼吸停止。①《本草经集注》：蜀漆为之使。恶莽草。②《日华子本草》：畏附子、干姜、生姜。③《本草备要》：阴虚燥痰禁用。④《会约医镜》：孕妇忌之。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:白附子" label="herb:白附子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白附子" />
          <attvalue for="4" value="376" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="祛风痰；通经络；解毒镇痛。主中风痰壅；口眼歪斜；偏头痛；破伤风；毒蛇咬伤；瘰疬结核；痈肿。祛风痰，定惊搐，解毒散结止痛。用于中风痰壅，口眼歪斜，语言涩謇，痰厥头痛，偏正头痛，喉痹咽痛，破伤风；外治瘰疬" />
          <attvalue for="7" value="白附子的功效：祛风痰，定惊搐，解毒散结止痛。用于中风痰壅，口眼歪斜，语言涩謇，痰厥头痛，偏正头痛，喉痹咽痛，破伤风；外治瘰疬痰核，毒蛇咬伤。" />
          <attvalue for="8" value="辛，温；有毒。" />
          <attvalue for="9" value="辛、甘" />
          <attvalue for="10" value="归胃、肝经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="血虚生风、内热生惊及孕妇禁服。孕妇慎用。生品内服宜慎。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:白芥子" label="herb:白芥子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白芥子" />
          <attvalue for="4" value="377" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="化痰逐饮；散结消肿。主咳喘痰多；胸满胁痛；肢体麻木；关节肿痛；湿痰流注；阴疽肿毒。治痰饮咳喘，胸胁胀满疼痛，反胃呕吐，中风不语，肢体痹痛麻木，脚气，阴疽，肿毒，跌打肿痛。①《别录》：发汗，主胸膈痰冷上" />
          <attvalue for="7" value="白芥子：利气豁痰，温中散寒，通络止痛。治痰饮咳喘，胸胁胀满疼痛，反胃呕吐，中风不语，肢体痹痛麻木，脚气，阴疽，肿毒，跌打肿痛。" />
          <attvalue for="8" value="辛，温。①《品汇精要》：味辛，性温，无毒" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入肺、胃经。①《雷公炮制药性解》：入肺、胃二经。②《本草新编" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="肺虚咳嗽、阴虚火旺者忌服。且多食昏目、泄气、伤精。①《本草经疏》：肺经有热，与夫阴虚火炎，咳嗽生痰者，法在所忌。②《本经逢原》：多食昏目、泄气、伤精。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:皂荚" label="herb:皂荚">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="皂荚" />
          <attvalue for="4" value="378" />
          <attvalue for="5" value="驱虫药" />
          <attvalue for="6" value="祛痰止咳；开窍通闭；杀虫散结。主痰咳喘满；中风口噤；痰涎壅盛；神昏不语；癫痫；喉痹；二便不通；痈肿疥癣。①《本经逢原》：按大小二皂，所治稍有不同，用治风痰，牙皂最胜，若治湿痰，大皂力优。②《本草图经》" />
          <attvalue for="7" value="1、" />
          <attvalue for="8" value="辛；咸；温；有毒。" />
          <attvalue for="9" value="辛、咸" />
          <attvalue for="10" value="肺；大肠经" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:旋覆花" label="herb:旋覆花">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="旋覆花" />
          <attvalue for="4" value="379" />
          <attvalue for="5" value="理气药" />
          <attvalue for="6" value="降气化痰，降逆止呕" />
          <attvalue for="7" value="1、用于痰饮壅肺或痰饮蓄结证2、用于噫气，呕吐" />
          <attvalue for="8" value="微温，肺脾胃大肠" />
          <attvalue for="9" value="苦、辛、咸" />
          <attvalue for="10" value="肺、脾、胃、大、肠" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:白前" label="herb:白前">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白前" />
          <attvalue for="4" value="380" />
          <attvalue for="5" value="理气药" />
          <attvalue for="6" value="泻肺降气；下痰止嗽。主主冶肺气壅实之咳嗽痰多；气逆喘促；胃脘疼痛；儿疳积；跌打损伤。用于肺气壅实，咳嗽痰多，胸满喘急。①《别录》：主胸胁逆气，咳嗽上气。②《纲目》：降气下痰。③《唐本草》：主上气冲喉中" />
          <attvalue for="7" value="白前：泻肺降气；下痰止嗽。主主冶肺气壅实之咳嗽痰多；气逆喘促；胃脘疼痛；儿疳积；跌打损伤。用于肺气壅实，咳嗽痰多，胸满喘急。" />
          <attvalue for="8" value="辛甘，微温。①《药性论》：味辛。②《别录" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="入肺经。①《纲目》：手太阴。②《本草再新》：入肝、肺二经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="《本草经疏》：凡咳逆上气，咳嗽气逆，由于气虚气不归元，而不由于肺气因邪客壅实者，禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:前胡" label="herb:前胡">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="前胡" />
          <attvalue for="4" value="381" />
          <attvalue for="5" value="解表药" />
          <attvalue for="6" value="疏散风热；降气化痰。主外感风热；肺热痰郁；咳喘痰多；痰黄稠粘；哎逆食少；胸膈满闷。用于风热咳嗽痰多，痰热喘满，咯痰黄稠。①《别录》：主疗痰满胸胁中痞，心腹结气，风头痛，去痰实，下气。治伤寒寒热，推陈致" />
          <attvalue for="7" value="前胡：疏散风热；降气化痰。主外感风热；肺热痰郁；咳喘痰多；痰黄稠粘；哎逆食少；胸膈满闷。用于风热咳嗽痰多，痰热喘满，咯痰黄稠。" />
          <attvalue for="8" value="味苦；辛；性微寒①《雷公炮炙论》：味甘微" />
          <attvalue for="9" value="苦辛微寒" />
          <attvalue for="10" value="入肺、脾经。①《纲目》：手足太阴、阳明。②《雷公炮制药性解》" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="①《本草经集注》：半夏为之使。恶皂荚。畏藜芦。②《本草经疏》：不可施诸气虚血少之病。凡阴虚火炽，煎熬真阴，凝结为痰而发咳喘；真气虚而气不归元，以致胸胁逆满；头痛不因于痰，而因于阴血虚；内热心烦，外现寒热而非外感者，法并禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:川贝母" label="herb:川贝母">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="川贝母" />
          <attvalue for="4" value="383" />
          <attvalue for="5" value="化痰止咳平喘药" />
          <attvalue for="6" value="清热润肺；化痰止咳；散结消肿。主肺虚；久咳；虚劳咳嗽；燥热咳嗽；肺痈；瘰疬；痈肿；乳痈。用于肺热燥咳，干咳少痰，阴虚劳嗽，咯痰带血。①《本经》：主伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金疮风痉。②《别" />
          <attvalue for="7" value="" />
          <attvalue for="8" value="味甘、苦；性微寒。①《本经》：味辛，平。" />
          <attvalue for="9" value="苦、甘" />
          <attvalue for="10" value="归肺、心经。①王好古：肺经。②《雷公炮制药性解》：入心、肺二" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚寒及有湿痰者不宜。①《本草经集庄》：厚朴、白薇为之使。恶槐花。畏秦艽、矾石、莽草。反乌头。②《本草经疏》：寒湿痰及食积痰火作嗽，湿痰在胃恶心欲吐，痰饮作寒热，脾胃湿痰作眩晕及我厥头痛中恶呕吐，胃寒作泄并禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:浙贝母" label="herb:浙贝母">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="浙贝母" />
          <attvalue for="4" value="384" />
          <attvalue for="5" value="解表药" />
          <attvalue for="6" value="清热化痰；降气止咳；散结消肿。主风热或痰热咳嗽；肺痈吐脓；瘰疬瘿瘤；疮痈肿毒。治风热咳嗽，肺痈喉痹，瘰疬，疮疡肿毒。①《本草正》：大治肺痈肺萎，咳喘，吐血，衄血，最降痰气，善开郁结，止疼痛，消胀满，清" />
          <attvalue for="7" value="浙贝母：清热化痰，散结解毒。治风热咳嗽，肺痈喉痹，瘰疬，疮疡肿毒。" />
          <attvalue for="8" value="《本草正》：味大苦，性寒。" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="归肺；心经《本草正》：入手太阴、少阳，足阳明、厥阴。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="寒痰、湿痰及脾胃虚寒者慎服。反乌头。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:瓜蒌" label="herb:瓜蒌">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="瓜蒌" />
          <attvalue for="4" value="385" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热涤痰，宽胸散结，润肠。用于肺热咳嗽，痰浊黄稠，胸痹心痛，乳痈、肺痈、肠痈肿痛。1.《品汇精要》：“消结痰，散痈毒。”2.《别录》：“主胸痹。”3.《江苏植药志》：“治水肿。”4.《本草图经》：“主" />
          <attvalue for="7" value="瓜蒌：清热涤痰，宽胸散结，润肠。用于肺热咳嗽，痰浊黄稠，胸痹心痛，乳痈、肺痈、肠痈肿痛。" />
          <attvalue for="8" value="性寒，味甘，微苦。①《日用本草》：“味苦" />
          <attvalue for="9" value="甘、微苦" />
          <attvalue for="10" value="归肺、胃、大肠经。①《本草汇言》：“入手少阴、太阴经。”②《" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="不宜与乌头类药材同用。①《本草经集注》：“枸杞为之使。恶干姜。畏牛膝、干漆。反乌头。”②《本草便读》：“冷滑大肠，脾虚无火、大便不实者不可用。”③《本经逢原》：“脾胃虚及呕吐自利者不可用。”" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:竹茹" label="herb:竹茹">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="竹茹" />
          <attvalue for="4" value="386" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="清热化痰，除烦止呕。用于痰热咳嗽，胆火挟痰，烦热呕吐，惊悸失眼，中风痰迷，舌强不语，胃热呕吐，妊娠恶阻，胎动不安。①《别录》：主呕畹，温气寒热，吐血，崩中溢筋。②《药性论》：止肺痿唾血，鼻衄，治五痔。" />
          <attvalue for="7" value="竹茹：清热化痰，除烦止呕。用于痰热咳嗽，胆火挟痰，烦热呕吐，惊悸失眼，中风痰迷，舌强不语，胃热呕吐，妊娠恶阻，胎动不安。" />
          <attvalue for="8" value="性微寒，味甘。①《别录》：微寒。②《药性" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="入胃、胆经。①《本草经疏》：入足阳明胃经。②《药品化义》：入" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="寒痰咳喘、胃寒呕逆及脾虚泄泻者禁服。①《本草经疏》：胃寒呕吐：及感寒挟食作吐忌用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:竹沥" label="herb:竹沥">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="竹沥" />
          <attvalue for="4" value="387" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热降火；滑痰利窍。主中风痰迷；肺热痰壅；惊风；癫痫；热病痰多；壮热烦渴；子烦；破伤风。用于中风痰壅，肺热喘咳，热病烦躁。①《别录》：疗暴中风风痹，胸中大热，止烦闷（《纲目》末句下有’消渴劳复’）。②" />
          <attvalue for="7" value="竹沥：清热滑痰，镇惊利窍。治中风痰迷，肺热痰壅，惊风，癫痫，壮热烦渴，子烦，破伤风。" />
          <attvalue for="8" value="甘苦，寒。①《别录》：大寒。②《纲目》：" />
          <attvalue for="9" value="甘寒" />
          <attvalue for="10" value="入心、胃经，①《药品化义》：入肺、胃二经。②《本草再新》：入" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="寒嗽及脾虚便溏者忌服。①《纲目》：姜汁为之使。②《本草经疏》：寒痰湿痰及次食生痰不宜用。③《本草备要》：寒胃滑肠，有寒湿者勿服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
