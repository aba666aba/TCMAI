      <node id="herb:板蓝根" label="herb:板蓝根">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="板蓝根" />
          <attvalue for="4" value="37" />
          <attvalue for="5" value="解表药" />
          <attvalue for="6" value="清热；解毒；凉血；利咽。主温毒发斑；高热头痛；大头瘟疫；烂喉丹痧；丹毒；痄腮；喉痹；疮肿；水痘；麻疹；肝炎；流行性感冒。用于温毒发斑，舌绛紫暗，痄腮，喉痹，烂喉丹痧，大头瘟疫，丹毒，痈肿。①《日华子本" />
          <attvalue for="7" value="板蓝根清热；解毒；凉血；利咽。主温毒发斑；高热头痛；大头瘟疫；烂喉丹痧；丹毒；痄腮；喉痹；疮肿；水痘；麻疹；肝炎；流行性感冒。" />
          <attvalue for="8" value="苦，寒。①《本草述》：苦，寒，无毒。②《" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="归心、胃经。①《本草便读》：入肝、胃血分。②《中华本草》：归" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="体虚而无实火热毒者忌服。中药板蓝根虽有抗病毒的作用，但中医学把感冒分为风寒型感冒和风热型感冒两大类，又由于季节的不同，感受外邪（致病因 子）的不同，又有夹湿、夹暑、夹燥的不同，如果患感冒不分寒热、虚实和夹杂，一味用板蓝根治疗，是不科学的。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
