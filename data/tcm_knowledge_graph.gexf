      <node id="herb:枯矾" label="herb:枯矾">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="枯矾" />
          <attvalue for="4" value="1594" />
          <attvalue for="5" value="清热解毒药" />
          <attvalue for="6" value="消痰，燥湿，止泻，止血，解毒，杀虫。治癫痫，喉痹，疚涎壅甚，肝炎，黄疸，黄肿，胃、十二指肠溃疡，子宫脱垂，白带，泻痢，衄血，口舌生疮，疮痔疥癣，水、火、虫伤。①《本经》：&quot;主寒热泄痢，白沃，阴蚀恶疮，" />
          <attvalue for="7" value="枯矾：消痰，燥湿，止泻，止血，解毒，杀虫。治癫痫，喉痹，疚涎壅甚，肝炎，黄疸，黄肿，胃、十二指肠溃疡，子宫脱垂，白带，泻痢，衄血，口舌生疮，疮痔疥癣，水、火、虫伤。" />
          <attvalue for="8" value="酸涩，寒。有毒。①《本经》：&quot;味酸，寒。" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="入肺、脾、胃、大肠经。①《雷公炮制药性解》：&quot;肺、肝二经。&quot;" />
          <attvalue for="11" value="煎服，6-15g" />
          <attvalue for="12" value="阴虚胃弱，无湿热者忌服。①《吴普本草》：&quot;歧伯：久服伤人骨。&quot;②《本草经集注》：&quot;甘草为之使。恶牡蛎。&quot;③《药性论》：&quot;畏麻黄。&quot;④《本草衍义》：&quot;不可多服，损心肺，却水故也。&quot;⑤《本草经疏》：&quot;凡阴虚内热，火炽水涸，发为咽喉痛者，不宜含此。目痛由阴虚血热者，亦不宜用。&quot;⑥《本草汇言》：&quot;泄痢日久，由于脾胃气虚；妇人白沃，由于中气下陷；营血不足以致寒热者，不宜用。&quot;" />
          <attvalue for="13" value="JSON数据源导入" />
        </attvalues>
      </node>
      <node id="herb:云母" label="herb:云母">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="云母" />
          <attvalue for="4" value="1595" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="安神镇惊；止血敛疮。主心悸；失眠；眩晕；癫痫；久泻；带下；外伤出血；湿疹。治虚喘，眩晕，惊悸，癫痫，寒疟，久痢，金创出血，痈疽疮毒。①《本经》：主身皮死肌，中风寒热，如在车船上，除邪气，安五脏，益子精" />
          <attvalue for="7" value="云母：纳气坠痰，止血敛疮。治虚喘，眩晕，惊悸，癫痫，寒疟，久痢，金创出血，痈疽疮毒。" />
          <attvalue for="8" value="甘，温。①《本经》：味甘，平。②《别录》" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="入肺，脾、膀胱经。①《长沙药解》：入足少阳胆、足太阳膀胱经。" />
          <attvalue for="11" value="煎服，6-15g" />
          <attvalue for="12" value="①《本草经集注》：泽泻为之使。畏鮀甲及流水。②《药性论》：恶徐长卿。忌羊血。③《本经逢原》：阴虚火炎者，慎勿误与。" />
          <attvalue for="13" value="JSON数据源导入" />
        </attvalues>
      </node>
      <node id="herb:滑石粉" label="herb:滑石粉">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="滑石粉" />
          <attvalue for="4" value="1596" />
          <attvalue for="5" value="清热解毒药" />
          <attvalue for="6" value="利尿通淋，清热解暑，祛湿敛疮。用于热淋，石淋，尿热涩痛，暑湿烦渴，湿热水泻；外治湿疹，湿疮，痱子。①《本经》：主身热泄澼，女子乳难，癃闭，利小便，荡胃中积聚寒热，益精气。②《别录》：通九窍六腑津液，去" />
          <attvalue for="7" value="滑石粉：利尿通淋，清热解暑，祛湿敛疮。用于热淋，石淋，尿热涩痛，暑湿烦渴，湿热水泻；外治湿疹，湿疮，痱子。" />
          <attvalue for="8" value="甘、淡，寒。①《本经》：味甘，寒。②《别" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="归膀胱、肺、胃经。①《汤液本草》：入足太阳经。②《雷公炮制药" />
          <attvalue for="11" value="煎服，6-15g" />
          <attvalue for="12" value="脾虚气弱，精滑及热病津伤者忌服。孕妇慎服。①《本草经集注》：石韦为之使。恶曾青。②《本草经疏》：病人因阴精不足、内热以致小水短少赤涩或不利，烦渴身热由于阴虚火炽水涸者，皆禁用。脾胃俱虚者，虽作泄勿服。③《药品化义》：渴而小便自利者，是内津液少也；小便不利而口不渴者，是热在下焦血分也，均不宜用。且体滑，胎前亦忌之。④《本经逢原》：元气下陷，小便清利及精滑者勿服。" />
          <attvalue for="13" value="JSON数据源导入" />
        </attvalues>
      </node>
      <node id="herb:白石英" label="herb:白石英">
