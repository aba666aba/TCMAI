          <attvalue for="7" value="风热感冒高热烦渴咽喉肿痛水肿尿少热淋涩痛痈肿疔毒" />
          <attvalue for="8" value="寒" />
          <attvalue for="9" value="甘、淡" />
          <attvalue for="10" value="肺、胃、膀胱经" />
