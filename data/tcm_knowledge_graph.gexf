      <node id="herb:鱼腥草" label="herb:鱼腥草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="鱼腥草" />
          <attvalue for="4" value="63" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热解毒；排脓消痈；利尿通淋。主肺痈吐脓；痰热喘咳；喉哦；热痢；痈肿疮毒；热淋。①《别录》：主蠼螋溺疮。②《日华子本草》：淡竹筒内煨，敷恶疮白秃。③《履巉岩本草》：大治中暑伏热闷乱，不省人事。④《滇南" />
          <attvalue for="7" value="鱼腥草：清热解毒，利尿消肿。治肺炎，肺脓疡，热痢，疟疾，水肿，淋病，白带，痈肿，痔疮，脱肛，湿疹，秃疮，疥癣。" />
          <attvalue for="8" value="辛，寒。①《别录》：味辛，微温。②《履巉" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="肝；肺经。①《本草经疏》：入手太阴经。②《本草再新》：入肝、" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="虚寒症及阴性外疡忌服。①《别录》：多食令人气喘。②孟诜：久食之，发虚弱，损阳气，消精髓。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:决明子" label="herb:决明子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="决明子" />
          <attvalue for="4" value="64" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="祛风清热，解毒利湿。主风热感冒，流感，急性结膜炎，湿热黄疸，急慢性肾炎，带下，瘰疬，疮痈疖肿，乳腺炎。用于目赤涩痛，羞明多泪，头痛眩晕，目暗不明，大便秘结。①《本经）：治青盲，目淫肤赤白膜，眼赤痛，泪" />
          <attvalue for="7" value="决明子：清肝，明目，利水，通便。治风热赤眼，青盲，雀目，高血压，肝炎，肝硬化腹水，习惯性便秘。" />
          <attvalue for="8" value="咸苦；平凉；无毒。①《本经》：味咸，平。" />
          <attvalue for="9" value="咸、甘、苦" />
          <attvalue for="10" value="入肝、肾经。①《雷公炮制药性解》：入肝经。②《本草经疏》：足" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="泄泻和血压低者慎用。①《本草经集注》：蓍实为之使。恶大麻子。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:枇杷叶" label="herb:枇杷叶">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="枇杷叶" />
          <attvalue for="4" value="65" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="清肺止咳，和胃降逆，止渴。主肺热痰嗽；阴虚劳嗽；咳血；衄血；胃热呕哕。用于肺热咳嗽，气逆喘急，胃热呕逆，烦热口渴。①《别录》：主卒啘不止，下气。②《食疗本草》：煮汁饮，主渴疾，治肺气热嗽及肺风疮，胸、" />
          <attvalue for="7" value="枇杷叶：清肺和胃，降气化痰。治肺热痰嗽，咳血，衄血，胃热呕哕。" />
          <attvalue for="8" value="苦、辛；寒；无毒。①《别录》：味苦，平，" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入肺、胃经。①《滇南本草》：入肺。②《本草经疏》：入手太阴、" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="《本草经疏》：胃寒呕吐及肺感风寒咳嗽者，法并忌之。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:栀子" label="herb:栀子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="栀子" />
          <attvalue for="4" value="66" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="清热，泻火，凉血。治热病虚烦不眠，黄疸，淋病，消渴，目赤，咽痛，吐血，衄血，血痢，尿血，热毒疮疡，扭伤肿痛。①《本经》：主五内邪气，胃中热气，面赤，酒疱皶鼻，白癞，赤癞，疮疡。②《本草经集注》：解踯躅" />
          <attvalue for="7" value="栀子：清热，泻火，凉血。治热病虚烦不眠，黄疸，淋病，消渴，目赤，咽痛，吐血，衄血，血痢，尿血，热毒疮疡，扭伤肿痛。" />
          <attvalue for="8" value="苦；寒。①《本经》：味苦，寒。②《别录》" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入心、肝、肺、胃经。①《汤液本草》：入手太阴经。②《雷公炮制" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾虚便溏者忌服。1.《本草汇言》：吐血衄血，非阳火暴发者忌之。2.《得配本草》：邪在表，虚火上升，二者禁用。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:夏枯草" label="herb:夏枯草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="夏枯草" />
          <attvalue for="4" value="67" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清肝明目；散结解毒。主目亦羞明；目珠疼痛；头痛眩晕；耳鸣；瘰疬；瘿瘤；乳痈；痄腮；痈疖肿毒；急、慢性肝炎；高血压病。用于目赤肿痛，目珠夜痛，头痛眩晕，瘰疬，瘿瘤，乳痈肿痛；甲状腺肿大，淋巴结结核，乳腺" />
          <attvalue for="7" value="夏枯草：清肝，散结。治瘰疬，瘿瘤，乳痈，乳癌，目珠夜痛，羞明流泪，头目眩晕，口眼歪斜，筋骨疼痛，肺结核，急性黄疸型传染性肝炎，血崩，带下。" />
          <attvalue for="8" value="味苦；辛；性寒。①《本经》：味苦辛，寒。" />
          <attvalue for="9" value="苦、辛" />
          <attvalue for="10" value="入肝、胆经。①《滇南本草》：入肝。②《本草经疏》：入足厥阴、" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚弱者慎服。①《本草经集注》：土瓜为之使。②《得配本草》：气虚者禁用。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
