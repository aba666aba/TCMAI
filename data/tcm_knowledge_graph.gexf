          <attvalue for="4" value="155" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热；解毒；杀虫；截疟；。主热毒血痢；冷痢；休息痢；疟疾；痔疮；痈肿；阴痒；白带；瘊疣；鸡眼。用于痢疾，疟疾；外治赘疣，鸡眼。①《生草药性备要》：凉血，去脾家疮，理跌打。②《纲目拾遗》：治痢，痔。③《" />
          <attvalue for="7" value="鸦胆子：清热；解毒；杀虫；截疟；。主热毒血痢；冷痢；休息痢；疟疾；痔疮；痈肿；阴痒；白带；瘊疣；鸡眼。用于痢疾，疟疾；外治赘疣，鸡眼。" />
          <attvalue for="8" value="味苦；性寒；小毒。①《医学衷中参西录》：" />
          <attvalue for="9" value="苦寒" />
          <attvalue for="10" value="归大肠、肝经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="现已知本品对胃肠道及肝肾均有损害，不宜多用久服。胃肠出血及肝肾病患者，应忌用或慎用。脾胃虚弱，呕吐者忌服。①《广西中草药》：孕妇和小儿慎用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:秦皮" label="herb:秦皮">
        <attvalues>
