      <node id="herb:葛根" label="herb:葛根">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="葛根" />
          <attvalue for="4" value="18" />
          <attvalue for="5" value="补阴药" />
          <attvalue for="6" value="解肌退热；发表透诊；生津止渴；升阳止泻。主外感发热；头项强痛；麻疹初起；疹出不畅；温病口渴；消渴病；泄泻；痢疾；高血压；冠心病。①《本经》：主消渴，身太热，呕吐，诸痹，起阴气，解诸毒。②《别录》：疗伤" />
          <attvalue for="7" value="葛根：解肌退热；发表透诊；生津止渴；升阳止泻。主外感发热；头项强痛；麻疹初起；疹出不畅；温病口渴；消渴病；泄泻；痢疾；高血压；冠心病。" />
          <attvalue for="8" value="甘；辛；平。①《本经》：味甘，平。②《别" />
          <attvalue for="9" value="甘、辛" />
          <attvalue for="10" value="入脾、胃经。①张元素：通行足阳明经。②《本草新编》：入胃，又" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="①张元素：不可多服，恐损胃气。②《本草正》：其性凉，易于动呕，胃寒者所当慎用。③《本草从新》：夏日表虚汗多尤忌。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
