      <node id="herb:荷叶" label="herb:荷叶">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="荷叶" />
          <attvalue for="4" value="1195" />
          <attvalue for="5" value="食疗药食同源" />
          <attvalue for="6" value="清热解暑；升发清阳；散瘀止血。主暑湿烦渴；头痛眩晕；脾虚腹胀；大便泄泻；叶血下血；产后恶露不净。治暑湿泄泻、眩晕，水气浮肿，雷头风，吐血，衄血，崩漏，便血，产后血晕。①盂诜：破血。②《本草拾遗》：主血" />
          <attvalue for="7" value="荷叶：清热解暑；升发清阳；散瘀止血。主暑湿烦渴；头痛眩晕；脾虚腹胀；大便泄泻；叶血下血；产后恶露不净。治暑湿泄泻、眩晕，水气浮肿，雷头风，吐血，衄血，崩漏，便血，产后血晕" />
          <attvalue for="8" value="苦；涩；平；①《滇南本草》：性微温平，味" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入心、肝、脾经。①《本草求真》：入胆。②《本草再新》：入心、" />
          <attvalue for="11" value="煎服3-10g" />
          <attvalue for="12" value="①《纲目》：畏桐油，茯苓、白银。②《本草从新》：升散消耗，虚者禁之。③《随息居饮食谱》：凡上焦邪盛，治宜清降者，切不可用。" />
          <attvalue for="13" value="V4系统扩充" />
        </attvalues>
      </node>
