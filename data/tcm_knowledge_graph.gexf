      <node id="herb:浮小麦" label="herb:浮小麦">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="浮小麦" />
          <attvalue for="4" value="501" />
          <attvalue for="5" value="补气药" />
          <attvalue for="6" value="除虚热；止汗。主止阴虚发热；盗汗；自汗。用于体虚多汗，脏躁症。①《本草蒙筌》：敛虚汗。②《纲目》：益气除热，止自汗盗汗，骨蒸虚热，妇人劳热。③《现代实用中药》：补心，止烦，除热，敛汗，利小便。" />
          <attvalue for="7" value="浮小麦：止虚汗，养心安神。用于体虚多汗，脏躁症。" />
          <attvalue for="8" value="味甘；性凉。①《纲目》：甘咸，寒，无毒。" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="心" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="《四川中药志》1960年版：无汗而烦躁或虚脱汗出者忌用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
