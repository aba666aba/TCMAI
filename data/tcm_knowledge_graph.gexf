          <attvalue for="4" value="125" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热燥湿；祛风止痒；解毒。主风热湿毒所致的风疹；湿疹；疥癣；黄疸；湿热 痹。用于湿热疮毒，黄水淋漓，湿疹，风疹，疥癣疮癞，风湿热痹，黄疸尿赤。①《本经》：主头风，黄疸，咳逆，淋沥，女子阴中肿痛，湿痹死" />
          <attvalue for="7" value="白鲜皮：清热燥湿；祛风止痒；解毒。主风热湿毒所致的风疹；湿疹；疥癣；黄疸；湿热 痹。" />
          <attvalue for="8" value="苦；咸；寒。①《本经》：味苦，寒。②《别" />
          <attvalue for="9" value="苦寒" />
          <attvalue for="10" value="入脾、胃经。①《纲目》：入足太阴、阳明经，兼人手太阴、阳明。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="虚寒证忌服。①《本草经集注》：恶螵蛸、桔梗、茯苓、萆薢。②《本草经疏》：下部虚寒之人，虽有湿证勿用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
