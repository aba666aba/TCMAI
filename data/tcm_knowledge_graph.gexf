      <node id="herb:紫石英" label="herb:紫石英">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="紫石英" />
          <attvalue for="4" value="1591" />
          <attvalue for="5" value="安神药" />
          <attvalue for="6" value="镇心；安神；降逆气；暖子宫。主心悸；怔忡；惊痫；肺寒咳逆上气；女子宫寒不孕。用于失眠多梦，心悸易惊，肺虚咳喘，宫寒不孕。①《药性论》：女子服之有子，主养肺气，治惊痫，蚀脓，虚而惊悸不安者，加而用之。②" />
          <attvalue for="7" value="紫石英：镇心；安神；降逆气；暖子宫。主心悸；怔忡；惊痫；肺寒咳逆上气；女子宫寒不孕。用于失眠多梦，心悸易惊，肺虚咳喘，宫寒不孕。" />
          <attvalue for="8" value="甘，温。①《本经》：味甘，温。②《别录》" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="入心、肝经。①《本草经解》：入足厥阴肝经，足太阴脾经。②《汤" />
          <attvalue for="11" value="煎服，6-15g" />
          <attvalue for="12" value="阴虚火旺者忌服。①《本草经集注》：长石为使。畏扁青、附子。不欲鮀甲、黄连、麦句姜。②《得配本草》：血热者忌用。③《本草经疏》：妇人绝孕由于阴虚火旺不能接受精气者忌用。" />
          <attvalue for="13" value="JSON数据源导入" />
        </attvalues>
      </node>
      <node id="herb:铜绿" label="herb:铜绿">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="铜绿" />
          <attvalue for="4" value="1592" />
          <attvalue for="5" value="清热解毒药" />
          <attvalue for="6" value="明目退翳；涌吐风痰；解毒祛腐；杀虫止痒。主目翳；眼睑糜烂；中风痰壅；痈疽；鼻息肉；喉痹；牙疳；臁疮；狐臭；顽癣；痔瘘。外用治鼻瘜肉，眼睑糜烂，疮疡顽癣。①《药对》：主风烂泪出。②《本草拾遗》：明目，去" />
          <attvalue for="7" value="铜绿：退翳，去腐，敛疮，杀虫，吐风痰。治目翳，烂弦风眼，疽、痔恶疮，喉痹，牙疳，臁疮，顽癣，风痰卒中。" />
          <attvalue for="8" value="酸涩，平，有毒。①《药对》：寒。②《嘉祐" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="入肝、胆经。①《纲目》：入肝、胆。②《玉楸药解》：入手太阴肺" />
          <attvalue for="11" value="煎服，6-15g" />
          <attvalue for="12" value="体弱血虚者忌服。不可多服，多量可引起剧烈呕吐、腹痛、血痢、痉挛等证，严重的可致虚脱。①《本草经疏》：目痛肤翳不由风热外侵而因于肝血虚少者非所宜用。②《本草汇言》：多服、常服，有燥耗津液、枯损血气之患。" />
          <attvalue for="13" value="JSON数据源导入" />
        </attvalues>
      </node>
