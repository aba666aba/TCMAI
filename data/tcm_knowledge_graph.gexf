      <node id="herb:何首乌" label="herb:何首乌">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="何首乌" />
          <attvalue for="4" value="22" />
          <attvalue for="5" value="补阳药" />
          <attvalue for="6" value="养血滋阴；润肠通便；截疟；祛风；解毒。主血虚头昏目眩；心悸；失眠；肝肾阴虚之腰膝酸软；须发早白；耳鸣；遗精；肠燥便秘；久疟体虚；风疹瘙痒；疮痈；瘰疬；痔疮。用于瘰疠疮痈，风疹瘙痒，肠燥便秘；高血脂。①" />
          <attvalue for="7" value="何首乌：补肝，益肾，养血，祛风。治肝肾阴亏，发须早白，血虚头晕，腰膝软弱，筋骨酸痛，遗精，崩带，久疟，久痢，慢性肝炎，痈肿，瘰疬，肠风，痔疾。制首乌补肝肾，益精血，乌须发" />
          <attvalue for="8" value="苦；甘；涩；性微温。①《何首乌录》：味甘" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="入肝、肾经。①《纲目》：足厥阴、少阴。②《本草经解》：入足少" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="大便溏泄及有湿痰者不宜。①《何首乌录》：忌猪、羊肉血。②《开宝本草》：忌铁。③《医学入门》：茯苓使。忌萝卜。得牛膝则下行。④《纲目》：忌葱、蒜。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:枸杞子" label="herb:枸杞子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="枸杞子" />
          <attvalue for="4" value="23" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="养肝；滋肾；润肺。主肝肾亏虚；头晕目眩；目视一清；腰膝酸软；阳痿贵精；虚劳咳嗽；消渴引饮。用于虚劳精亏，腰膝酸痛，眩晕耳鸣，内热消渴，血虚萎黄，目昏不明。①陶弘景:补益精气，强盛阴道。②《药性论》:能" />
          <attvalue for="7" value="枸杞子：滋肾，润肺，补肝，明目。治肝肾阴亏，腰膝酸软，头晕，目眩，目昏多泪，虚劳咳嗽，消渴，遗精。" />
          <attvalue for="8" value="味甘；性平。①《别录》:微寒，无毒。②《" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="入肝、肾经。①《本草汇言》:入足少阴、足厥阴经。②《本草经解" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="外邪实热，脾虚有湿及泄泻者忌服。①《本草经疏》:脾胃薄弱，时时泄泻者勿入。②《本草汇言》:脾胃有寒痰冷癖者勿入。③《本经逢原》:元阳气衰，阴虚精滑之人慎用。④《本草撮要》:得熟地良。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:冬虫夏草" label="herb:冬虫夏草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="冬虫夏草" />
          <attvalue for="4" value="24" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="保肺气；实腠理；补肾益精。主肺虚咳喘；劳嗽痰血；自汗；盗汗；肾亏阳痿；遗精；腰膝酸痛。用于久咳虚喘，劳嗽咯血，阳痿遗精，腰膝酸痛。①《本草从新》：保肺益肾，止血化痰，已劳嗽。②《药性考》：秘精益气，专" />
          <attvalue for="7" value="冬虫夏草：补虚损，益精气，止咳化痰。治痰饮喘嗽，虚喘，痨嗽，咯血，自汗盗汗，阳痿遗精，腰膝酸痛，病后久虚不复。" />
          <attvalue for="8" value="甘；温；香。①《本草从新》：甘，平。②《" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="归肺、肾经。①《本草再新》：入肺、肾二经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="《四川中药志》：有表邪者慎用。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:三七" label="herb:三七">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="三七" />
          <attvalue for="4" value="25" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="止血；散血；定痛。主跌扑瘀肿，胸痹绞痛，症瘕；血瘀经闭；痛经；产后瘀阴腹痛；疮痈肿痛。用于咯血，吐血，衄血，便血，崩漏，外伤出血，胸腹剌痛，跌扑肿痛。①《纲目》：止血，散血，定痛。金刃箭伤，跌扑杖疮，" />
          <attvalue for="7" value="三七：止血；散血；定痛。主跌扑瘀肿，胸痹绞痛，症瘕；血瘀经闭；痛经；产后瘀阴腹痛；疮痈肿痛。用于咯血，吐血，衄血，便血，崩漏，外伤出血，胸腹剌痛，跌扑肿痛。" />
          <attvalue for="8" value="味甘；微苦；性湿①《纲目》：甘微苦，温，" />
          <attvalue for="9" value="甘、苦" />
          <attvalue for="10" value="归肝；胃；心；肺；大肠经①《本草汇言》：入阳明、厥阴经。②《" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="孕妇忌服。①《本草从新》：能损新血，无瘀者勿用。②《得配本草》：血虚吐衄，血热妄行者禁用。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
