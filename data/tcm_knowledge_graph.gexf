          <attvalue for="9" value="苦、辛" />
          <attvalue for="10" value="入肝。脾经。①《雷公炮制药性解》：入肺、脾二经。②《本草经疏" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="气虚体弱，血枯经闭及孕妇忌服。①《医学启源》：破气损真，气虚人不用。②《品汇精要》：妊娠不可服。③《得配本草》：素有血症者禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
          <attvalue for="14" value="true" />
        </attvalues>
      </node>
      <node id="herb:水蛭" label="herb:水蛭">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="水蛭" />
          <attvalue for="4" value="370" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="破血逐瘀；通经消症。主血瘀经闭；症瘕痞块；跌打损伤。用于癥瘕痞块，血瘀经闭，跌扑损伤。①《本经》：主逐恶血、瘀血、月闭，破血瘕积聚，无子，利水道。②《别录》：堕胎。③《本草拾遗》：人患赤白游疹及痈肿毒" />
          <attvalue for="7" value="水蛭：破血，逐瘀，通经。治蓄血，癥瘕，积聚，妇女经闭，干血成痨，跌扑损伤，目亦痛，云翳。" />
          <attvalue for="8" value="味咸；苦；性平；有毒。①《本经》：味咸，" />
          <attvalue for="9" value="咸苦平有小毒" />
          <attvalue for="10" value="入肝、膀胱经。①《纲目》：肝经血分。②《要药分剂》：入肝、膀" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="体弱血虚，无瘀血停聚及孕妇忌服。①《日华于本草》：畏石灰。②《本草衍义》：畏盐。③《品汇精要》：妊娠不可服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
          <attvalue for="14" value="true" />
        </attvalues>
      </node>
      <node id="herb:虻虫" label="herb:虻虫">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="虻虫" />
          <attvalue for="4" value="371" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="破血通经，逐瘀消癥" />
          <attvalue for="7" value="1.癥瘕痞块，血瘀经闭。2。跌打损伤，血瘀肿痛" />
          <attvalue for="8" value="有毒，肝" />
          <attvalue for="9" value="苦微寒" />
          <attvalue for="10" value="" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
