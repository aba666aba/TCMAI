      <node id="herb:橘红" label="herb:橘红">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="橘红" />
          <attvalue for="4" value="283" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="散寒燥湿；理气化痰；宽中健胃。主风寒咳嗽；痰多气逆；恶心呕吐；胸脘痞胀。用于风寒咳嗽，喉痒痰多，食积伤酒，呕恶痞闷。①《医学启源》：理胸中、肺气。②《纲目》：下气消痰。③《本草汇》：能除寒发表。" />
          <attvalue for="7" value="橘红：散寒燥湿；理气化痰；宽中健胃。主风寒咳嗽；痰多气逆；恶心呕吐；胸脘痞胀。用于风寒咳嗽，喉痒痰多，食积伤酒，呕恶痞闷。" />
          <attvalue for="8" value="辛；苦；温。①《本草原始》：味辛苦。②《" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="归肺、脾经。①《本草汇言》：入手足太阳、太阴、阳明经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚燥咳及久嗽气虚者不宜服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:青皮" label="herb:青皮">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="青皮" />
          <attvalue for="4" value="284" />
          <attvalue for="5" value="理气药" />
          <attvalue for="6" value="疏肝破气；消积化滞。主肝郁气滞之胁肋胀痛；乳房胀痛；乳核；乳痈；疝气疼痛；食积气滞之胃脘胀痛；以及气滞血瘀所至的症瘕积聚；久疟癖块。用于胸胁胀痛，疝气，乳核，乳痈，食积腹痛。①《本草图经》：主气滞，下" />
          <attvalue for="7" value="青皮：疏肝破气；消积化滞。主肝郁气滞之胁肋胀痛；乳房胀痛；乳核；乳痈；疝气疼痛；食积气滞之胃脘胀痛；以及气滞血瘀所至的症瘕积聚；久疟癖块。用于胸胁胀痛，疝气，乳核，乳痈，" />
          <attvalue for="8" value="苦辛，微温。①《本草图经》：味苦。②《医" />
          <attvalue for="9" value="苦、辛" />
          <attvalue for="10" value="入肝、胆经.①李杲：足厥阴、少阳经之引经药。②《汤液本草》：" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="气虚者慎服。①《仁斋直指方》：有汗者不可用。②《本草蒙筌》：老弱虚羸，尤宜全戒。③《本草经疏》：肝脾气虚者，概勿使用。" />
