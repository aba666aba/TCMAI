      <node id="herb:巴豆" label="herb:巴豆">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="巴豆" />
          <attvalue for="4" value="195" />
          <attvalue for="5" value="泻下药" />
          <attvalue for="6" value="泻下寒积；逐水退肿；祛痰利咽；蚀疮杀虫。主寒邪食积所致的胸腹胀满急痛；大便不通；泄泻痢疾；水肿腹大；痰饮喘满；喉风喉痹；痈疽；恶疮疥癣。用于恶疮疥癣，疣痣，白喉，疟疾，肠梗阻。①《本经》：主伤寒温疟寒" />
          <attvalue for="7" value="巴豆：泻寒积，通关窍，逐痰，行水，杀虫。治冷积凝滞，胸腹胀满急痛，血瘕，痰癖，泻痢，水肿，外用治喉风，喉痹，恶疮疥癣。" />
          <attvalue for="8" value="辛，热，有毒。①《本经》：味辛，温。②《" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入胃、大肠经。①《雷公炮制药性解》：入脾、胃、大肠三经。②《" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="无寒实积滞、孕妇及体弱者忌服。不宜与牵牛子同用。①《本草经集注》：芫花为之使。恶蘘草。畏大黄、黄连、藜芦。②《药对》：畏芦笋、菰笋、酱鼓、冷水。得火良。与牵牛相反。③《药性论》：能落胎。④《本草衍义补遗》：无寒积者忌之。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
          <attvalue for="14" value="true" />
          <attvalue for="15" value="true" />
        </attvalues>
      </node>
      <node id="herb:独活" label="herb:独活">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="独活" />
          <attvalue for="4" value="196" />
          <attvalue for="5" value="解表药" />
          <attvalue for="6" value="祛风，胜湿，散寒，止痛。治风寒湿痹，腰膝酸痛，手脚挛痛，慢性气管炎，头痛，齿痛。①《本经》：主风寒所击，金疮止痛，奔豚，痫痓，女子疝瘕。②《别录》：治诸风，百节痛风无久新者。③《药性论》：治中诸风湿冷" />
          <attvalue for="7" value="独活：祛风，胜湿，散寒，止痛。治风寒湿痹，腰膝酸痛，手脚挛痛，慢性气管炎，头痛，齿痛。" />
          <attvalue for="8" value="辛、苦，微温。①《本经》：苦，平。②《别" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="入肾、膀胱经。①《珍珠囊》：足少阴肾，手少阴心经。②《雷公炮" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚血燥者慎服。①《本草经集注》：蠡实为之使。②《本经逢原》：气血虚而遍身痛及阴虚下体瘙弱者禁用。一切虚风类中，咸非独活所宜。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:防己" label="herb:防己">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="防己" />
          <attvalue for="4" value="197" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="行水，泻下焦湿热。治水肿臌胀，湿热脚气，手足挛痛，癣疥疮肿。用于水肿脚气，小便不利，湿疹疮毒，风湿痹痛；高血压。①《本经》：主风寒温疟，热气诸痫。除邪，利大小便。②《别录》：疗水肿、风肿，去膀胱热，伤" />
          <attvalue for="7" value="防己：行水，泻下焦湿热。治水肿臌胀，湿热脚气，手足挛痛，癣疥疮肿。" />
          <attvalue for="8" value="苦，寒。①《本经》：味辛，平。②《药性论" />
          <attvalue for="9" value="苦、辛" />
          <attvalue for="10" value="入膀胱、脾、肾经。①《本草通玄》：入太阳。②《本草新编》：入" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚而无湿热者慎服。①《本草经集注》：殷孽为之使。恶细辛。畏萆薢。杀雄黄毒。②《药性论》：木防己：畏女菀、卤咸。③李杲：上焦湿热者，不可用。④《本草经疏》：凡胃虚阴虚，自汗盗汗，口苦舌干，肾虚小水不利，及胎前产后血虚，虽有下焦置热，均忌。⑤《得配本草》：气分风热，小便不通，禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
