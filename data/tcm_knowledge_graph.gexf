      <node id="herb:熟地黄" label="herb:熟地黄">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="熟地黄" />
          <attvalue for="4" value="480" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="补血滋润；益精填髓。主血虎萎黄；眩晕心悸；月经不调；崩不止；肝肾阴亏；潮热盗汗；遗精阳痿；不育不孕；腰膝酸软；耳鸣耳聋；头目昏花；须发早白；消渴；便秘；肾虚喘促。用于肝肾阴虚，腰膝酸软，骨蒸潮热，盗汗" />
          <attvalue for="7" value="熟地黄：滋阴补血，益精填髓。用于肝肾阴虚，腰膝酸软，骨蒸潮热，盗汗遗精，内热消渴，血虚萎黄，心悸怔忡，月经不调，崩漏下血，眩晕，耳鸣，须发早白。" />
          <attvalue for="8" value="味甘；性温。①《珍珠囊》：甘苦。②《纲目" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="入肝、肾经。①李杲：入手足少阴、厥阴经。②《本草从新》：入足" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚弱，气滞痰多，腹满便溏者忌服。1．《雷公炮炙论》：勿令犯铜铁器，令人肾消并白髭发、损荣卫也。2．《医学人门》：中满痰盛者慎用。3．《本草从新》：气郁之人，能窒碍胸膈，用宜斟酌。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:阿胶" label="herb:阿胶">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="阿胶" />
          <attvalue for="4" value="482" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="补血；止血；滋阴；润燥。主血虚证；虚劳咯血；吐血；尿血；便血；血痢；妊娠下血；崩漏；阴虚心烦失眠；肺虚澡咳；虚风内动之痉厥抽搐。用于血虚萎黄，眩晕心悸，肌痿无力，心烦不眠，虚风内动，肺燥咳嗽，劳嗽咯血" />
          <attvalue for="7" value="阿胶：滋阴补血，安胎。治血虚，虚劳咳嗽，吐血，衄血、便血，妇女月经不调，崩中，胎漏。" />
          <attvalue for="8" value="味甘；性平。①《本经》：味甘，平。②《别" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="入肺、肝、肾经。①《汤液本草》：入手太阴、足少阴、厥阴经。②" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚弱者慎服。①《本草经集注》：得火良，畏大黄。②《药性论》：薯蓣为之使。③《本草经疏》：性粘腻，胃弱作呕吐者勿服；脾胃虚，食不消者亦忌之。④《本草汇言》：胃弱呕吐有寒痰留饮者当忌之。⑤《本草备要》：泻者忌用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:龙眼肉" label="herb:龙眼肉">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="龙眼肉" />
          <attvalue for="4" value="483" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="补心脾；益气血；安心神。主心脾两虚；气血不足所致的惊悸；怔忡；失眠；健忘；血虚萎黄；有经不调；崩漏。用于气血不足，心悸怔忡，健忘失眠，血虚萎黄。①《本经》：主五脏邪气，安志、厌食，久服强魂魄，聪明。②" />
          <attvalue for="7" value="龙眼肉：补心脾；益气血；安心神。主心脾两虚；气血不足所致的惊悸；怔忡；失眠；健忘；血虚萎黄；有经不调；崩漏" />
          <attvalue for="8" value="甘，温，①《本经》：味甘，平。②《别录》" />
          <attvalue for="9" value="甘" />
