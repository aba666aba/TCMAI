      <node id="herb:金刚藤头" label="herb:金刚藤头">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="金刚藤头" />
          <attvalue for="4" value="1363" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="祛风湿，利小便，消肿毒。治关节疼痛，肌肉麻木，泄泻，痢疾，水肿，淋病，疔疮，肿毒，瘰疬，痔疮。①《别录》：主腰背寒痛，风痹，益血气，止小便利。②《日华子本草》：治时疾瘟瘴。③《品汇精要》：散肿毒。④《" />
          <attvalue for="7" value="金刚藤头：祛风；清热；利湿；解毒。主风湿痹证；腰腿疼痛；跌打损伤；小便淋涩；瘰疬；痈肿疮毒；臁疮。" />
          <attvalue for="8" value="甘，温。①《别录》：味甘，平温，无毒。②" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="《纲目》：足厥阴、少阴。" />
          <attvalue for="11" value="煎服，6-15g" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="JSON数据源导入" />
        </attvalues>
      </node>
      <node id="herb:矮脚罗伞" label="herb:矮脚罗伞">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="矮脚罗伞" />
          <attvalue for="4" value="1364" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="祛风湿；活血止痛。主风湿痹痛；咳嗽吐血；寒气腹痛；跌打损伤；痈疮肿痛。治风湿疼痛，跌打肿痛，咳嗽吐血，寒气腹痛。①《植物名实图考》：治跌打损伤，风痛。②《陆川本草》：根：接骨，活血，止痛，消肿。治损伤" />
          <attvalue for="7" value="矮脚罗伞：祛风除湿，活血止痛。治风湿疼痛，跌打肿痛，咳嗽吐血，寒气腹痛。" />
          <attvalue for="8" value="苦辛，温。①《植物名实图考》：性热。②《" />
          <attvalue for="9" value="" />
          <attvalue for="10" value="" />
          <attvalue for="11" value="煎服，6-15g" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="JSON数据源导入" />
        </attvalues>
      </node>
