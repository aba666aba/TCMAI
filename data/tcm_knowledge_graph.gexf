          <attvalue for="4" value="1037" />
          <attvalue for="5" value="消食药" />
          <attvalue for="6" value="消食和中，健脾开胃" />
          <attvalue for="7" value="食积不消，腹胀口臭，脾胃虚弱，不饥食少" />
          <attvalue for="8" value="平" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="脾、胃经" />
          <attvalue for="11" value="煎服，9-15g" />
          <attvalue for="12" value="无特殊禁忌" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
      <node id="herb:代赭石" label="herb:代赭石">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="代赭石" />
          <attvalue for="4" value="1038" />
          <attvalue for="5" value="平肝息风药" />
          <attvalue for="6" value="平肝潜阳；重镇降逆；凉血止血。主头痛；眩晕；心悸；癫狂；惊痫；呕吐；噫气；呃逆；噎膈；咳嗽；气喘；吐血；鼻衄；崩漏；便血；尿血①《本经》：主贼风蛊毒，腹中毒邪气，女子赤沃漏下。②《别录》：主带下百病，" />
          <attvalue for="7" value="代赭石：平肝镇逆，凉血止血。治噫气呕逆，噎膈反胃，哮喘，惊痫，吐血，鼻衄，肠风，痔瘘，崩漏带下。" />
          <attvalue for="8" value="苦甘；平；寒；无毒。①《本经》：味苦，寒" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入肝、胃、心胞经。①《汤液本草》：入手少阴、足厥阴经。②《本" />
          <attvalue for="11" value="先煎，9-30g" />
          <attvalue for="12" value="孕妇慎服。①《本草经集注》：畏天雄。②《药性论》：干姜为使。③《日华子本草》：畏附子。④《本草蒙筌》：孕妇忌服。⑤《本草经疏》：下部虚寒者，不宜用；阳虚阴萎者忌之。⑥《得配本草》：气不足、津液燥者禁用。" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
      <node id="herb:刺蒺藜" label="herb:刺蒺藜">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="刺蒺藜" />
          <attvalue for="4" value="1039" />
          <attvalue for="5" value="平肝息风药" />
          <attvalue for="6" value="平肝；解郁；祛风明目。主头痛；眩晕；胸胁胀痛；乳房胀痛；乳闭不通；经闭；目赤翳障；风疹瘙痒；白癜风；疮疽；瘰疬。①《本经》：主恶血，破瘫结积聚，喉痹，乳难。②《别录》：主身体风痒，头痛、咳逆伤肺，肺痿" />
          <attvalue for="7" value="刺蒺藜：平肝；解郁；祛风明目。主头痛；眩晕；胸胁胀痛；乳房胀痛；乳闭不通；经闭；目赤翳障；风疹瘙痒；白癜风；疮疽；瘰疬。" />
          <attvalue for="8" value="味苦；辛；性平。①《本经》：味苦，温。②" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="入肝、肺经。①《雷公炮制药性解》：入肺、肝、肾三经。②《本草" />
          <attvalue for="11" value="煎服，6-10g" />
          <attvalue for="12" value="血虚气弱及孕妇慎服。①《本草经集注》：乌头为之使。②《本草汇言》：阴虚不足，精髓血津枯燥至疾者，俱禁用之。③《得配本草》：肝虚，受孕，二者禁用。" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
      <node id="herb:豨莶草" label="herb:豨莶草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="豨莶草" />
          <attvalue for="4" value="1040" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="祛风湿，利关节，解毒" />
          <attvalue for="7" value="风湿痹痛，筋骨无力，腰膝酸软，四肢麻痹，半身不遂，风疹湿疮" />
          <attvalue for="8" value="寒" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="肝、肾经" />
          <attvalue for="11" value="煎服，9-12g" />
          <attvalue for="12" value="阴血不足者忌服" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
      <node id="herb:青风藤" label="herb:青风藤">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="青风藤" />
          <attvalue for="4" value="1041" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="祛风湿，利小便。治风湿痹痛，鹤膝风，水肿，脚气。用于风湿痹痛，关节肿胀，麻痹瘙痒。①《本草图经》：治风。②《纲目》：治风湿流注，历节鹤膝，麻痹瘙痒，损伤疮肿，入酒药中用。③《浙江天目山药植志》：行水利" />
          <attvalue for="7" value="青风藤：祛风湿，利小便。治风湿痹痛，鹤膝风，水肿，脚气。" />
          <attvalue for="8" value="苦、辛，平。①《本草便读》：苦，平。②《" />
          <attvalue for="9" value="苦、辛" />
          <attvalue for="10" value="归肝、脾经。" />
          <attvalue for="11" value="煎服，6-12g" />
          <attvalue for="12" value="脾胃虚寒者慎服。" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
      <node id="herb:青黛" label="herb:青黛">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="青黛" />
          <attvalue for="4" value="1042" />
          <attvalue for="5" value="清热解毒药" />
          <attvalue for="6" value="清热解毒；凉血止血；清肝泻火。主温病热毒斑疹；血热吐血；衄血；咯血；肝热惊痫；肝火犯肺咳嗽；咽喉肿痛；丹毒；痄；疮肿；蛇虫咬伤①《药性论》：解小儿疳热、消瘦，杀虫。②《本草拾遗》：解毒。小儿丹热，和水" />
          <attvalue for="7" value="青黛：清热解毒；凉血止血；清肝泻火。主温病热毒斑疹；血热吐血；衄血；咯血；肝热惊痫；肝火犯肺咳嗽；咽喉肿痛；丹毒；痄；疮肿；蛇虫咬伤" />
          <attvalue for="8" value="味咸；性寒。①《药性论》：味甘，平。②《" />
          <attvalue for="9" value="咸" />
          <attvalue for="10" value="入肝、肺、胃经。①《雷公炮制药性解》：入肝、脾二经。②《本草" />
          <attvalue for="11" value="入丸散，1-3g" />
          <attvalue for="12" value="《本草从新》：中寒者勿使。" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
