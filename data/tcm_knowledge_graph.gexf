      <node id="herb:穿心莲" label="herb:穿心莲">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="穿心莲" />
          <attvalue for="4" value="1044" />
          <attvalue for="5" value="清热解毒药" />
          <attvalue for="6" value="清热解毒；泻火；燥湿。主风热感冒；温病发热；肺热咳嗽；百日咳；肺痈；咽喉肿痛；湿热黄疸；淋证；丹毒；疮疡痈肿；湿疹；毒蛇咬伤。用于感冒发热，咽喉肿痛，口舌生疮，顿咳劳嗽，泄泻痢疾，热淋涩痛，痈肿疮疡，" />
          <attvalue for="7" value="穿心莲：清热解毒，凉血消肿。治急性菌痢，胃肠炎，感冒，流脑，气管炎，肺炎，百日咳，肺结核，肺脓疡，胆囊炎，高血压，鼻衄，口咽肿痛，疮疖痈肿，水火烫伤，毒蛇咬伤。" />
          <attvalue for="8" value="味苦；性寒《泉州本草》：味苦，性寒，无毒" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="归心；肺；大肠；膀胱经《泉州本草》：入心、肺二经。" />
          <attvalue for="11" value="煎服，6-9g" />
          <attvalue for="12" value="阳虚证及脾胃弱者慎服。" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
      <node id="herb:沙棘" label="herb:沙棘">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="沙棘" />
          <attvalue for="4" value="1045" />
          <attvalue for="5" value="补气药" />
          <attvalue for="6" value="止咳化痰；健胃消食；活血散瘀。主咳嗽痰多；肺脓肿；消化不良；食积腹痛；胃痛；肠炎；闭经；跌打瘀肿。用于咳嗽痰多，消化不良，食积腹痛，瘀血经闭，跌扑瘀肿。" />
          <attvalue for="7" value="沙棘：止咳化痰；健胃消食；活血散瘀。主咳嗽痰多；肺脓肿；消化不良；食积腹痛；胃痛；肠炎；闭经；跌打瘀肿。用于咳嗽痰多，消化不良，食积腹痛，瘀血经闭，跌扑瘀肿。" />
          <attvalue for="8" value="味酸；涩；性温。" />
          <attvalue for="9" value="酸、涩" />
          <attvalue for="10" value="脾、胃、肺、心经" />
          <attvalue for="11" value="煎服，3-10g" />
          <attvalue for="12" value="无特殊禁忌" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
