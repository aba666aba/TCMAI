          <attvalue for="6" value="清热解毒利尿通淋" />
          <attvalue for="7" value="各种癌症炎症" />
          <attvalue for="8" value="凉" />
          <attvalue for="9" value="甘、淡" />
          <attvalue for="10" value="胃、大肠经" />
