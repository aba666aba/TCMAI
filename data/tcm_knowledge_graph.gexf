      <node id="herb:紫苏子" label="herb:紫苏子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="紫苏子" />
          <attvalue for="4" value="1067" />
          <attvalue for="5" value="化痰止咳平喘药-止咳平喘" />
          <attvalue for="6" value="降气；消痰；平喘；润肠。主痰壅气逆；咳嗽气喘；肠燥便秘。用于痰壅气逆，咳嗽气喘，肠燥便秘。①《别录》：主下气，除寒中。②《药性论》：主上气咳逆。治冷气及腰脚中湿风结气。③《日华子本草》：主调中，益五脏" />
          <attvalue for="7" value="紫苏子：降气；消痰；平喘；润肠。主痰壅气逆；咳嗽气喘；肠燥便秘。用于痰壅气逆，咳嗽气喘，肠燥便秘。" />
          <attvalue for="8" value="味辛；性温。①《别录》：味辛，温。②《药" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入肺、大肠经。①《药品化义》：入肺经。②《本草再新》：入肝、" />
          <attvalue for="11" value="煎服，3-10g" />
          <attvalue for="12" value="《本草逢原》：性主疏泄，气虚久嗽、阴虚喘逆、脾虚便滑者皆不可用。" />
          <attvalue for="13" value="V4系统扩充" />
        </attvalues>
      </node>
