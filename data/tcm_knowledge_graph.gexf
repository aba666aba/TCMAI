      <node id="herb:五味子" label="herb:五味子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="五味子" />
          <attvalue for="4" value="503" />
          <attvalue for="5" value="安神药" />
          <attvalue for="6" value="收敛固涩；益气生津；宁心安神。主咳嗽虚喘；梦遗滑精；尿颇遗尿；久泻不止；自汗盗汗；津伤口渴；心悸失眠。用于久嗽虚喘，梦遗滑精，遗尿尿频，久泻不止，自汗，盗汗，津伤口渴，短气脉虚，内热消渴，心悸失眠。①" />
          <attvalue for="7" value="五味子：敛肺，滋肾，生津，收汗，涩精。治肺虚喘咳，口干作渴，自汗，盗汗，劳伤羸瘦，梦遗滑精，久泻久痢。" />
          <attvalue for="8" value="味酸；性温。①《本经》：味酸，温。②《别" />
          <attvalue for="9" value="酸、甘" />
          <attvalue for="10" value="入肺、肾经，①《汤液本草》：入手太阴，足少阴经。②《纲目》：" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="外有表邪，内有实热，或咳嗽初起、痧疹初发者忌服。①《本草经集注》：苁蓉为之使。恶萎蕤。胜乌头。②《本草经疏》：痧疹初发及一叨停饮，肝家有动气，肺家有实热，应用黄芩泻热者，皆禁用。③《本草正》：感寒初嗽当忌，恐其敛束不散。肝旺吞酸当忌，恐其助木伤土。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:乌梅" label="herb:乌梅">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="乌梅" />
          <attvalue for="4" value="504" />
          <attvalue for="5" value="驱虫药" />
          <attvalue for="6" value="敛肺止咳；涩肠止泻；止血；生津；安蛔。主久咳；虚热烦渴；久疟；久泻；痢疾；便血；尿血；血崩；蛔厥腹痛；呕吐；钩虫病。用于肺虚久咳，久痢滑肠，虚热消渴，蛔厥呕吐腹痛，胆道蛔虫症。①《本经》：主下气，除热" />
          <attvalue for="7" value="乌梅：敛肺止咳；涩肠止泻；止血；生津；安蛔。主久咳；虚热烦渴；久疟；久泻；痢疾；便血；尿血；血崩；蛔厥腹痛；呕吐；钩虫病。用于肺虚久咳，久痢滑肠，虚热消渴，蛔厥呕吐腹痛，" />
          <attvalue for="8" value="味酸；性平。①《本经》：味酸，平。②《别" />
          <attvalue for="9" value="酸、涩" />
          <attvalue for="10" value="入肝、脾、肺、大肠经。①王好古：入脾、肺二经血分。②《雷公炮" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="有实邪者忌服。①孟诜：多食损齿，②《日华子本草》：多啖伤骨，蚀脾胃，令人发热。③《本草经疏》：不宜多食，齿痛及病当发散者咸忌之。④《药品化义》：咳嗽初起，气实喘促，胸膈痞闷，恐酸以束邪气，戒之。⑤《得配本草》：疟痢初起者禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:五倍子" label="herb:五倍子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="五倍子" />
          <attvalue for="4" value="505" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="敛肺；止汗；涩肠；固精；止血；解毒。主肺虚久咳；自汗盗汗；久痢久泻；脱肛；遗精；白浊；各种出血；痈肿疮疖。用于肺虚久咳，肺热痰嗽，久泻久痢，盗汗，消渴，便血痔血，外伤出血，痈肿疮毒，皮肤湿烂。①《本草" />
          <attvalue for="7" value="五倍子：敛肺；止汗；涩肠；固精；止血；解毒。主肺虚久咳；自汗盗汗；久痢久泻；脱肛；遗精；白浊；各种出血；痈肿疮疖" />
          <attvalue for="8" value="酸；涩；寒。①《开宝本草》：味苦酸，平，" />
          <attvalue for="9" value="酸、涩" />
          <attvalue for="10" value="入肺、胃、大肠经。①《雷公炮制药性解》：入大肠经。②《本草经" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="外感风寒或肺有实热之咳嗽及积滞未清之泻痢忌服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:诃子" label="herb:诃子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="诃子" />
          <attvalue for="4" value="506" />
          <attvalue for="5" value="化痰止咳平喘药" />
          <attvalue for="6" value="敛肺；涩肠；下气；利咽。主久泻；久痢；脱肛；喘咳痰嗽；久咳失音。用于久泻久痢，便血脱肛，肺虚喘咳，久嗽不止，咽痛音哑。①《南方草木状》：可作饮，变白髭发令黑。②《药性论》：通利津液，主破胸脯结气，止水" />
          <attvalue for="7" value="诃子：敛肺；涩肠；下气；利咽。主久泻；久痢；脱肛；喘咳痰嗽；久咳失音。用于久泻久痢，便血脱肛，肺虚喘咳，久嗽不止，咽痛音哑。" />
          <attvalue for="8" value="味苦；酸；涩；性平。①《药性论》：味苦甘" />
          <attvalue for="9" value="苦、酸、涩" />
          <attvalue for="10" value="入肺、胃、大肠经。①《雷公炮制药性解》：入肺、肝、脾、肾、大" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="凡外邪未解，内有湿热火邪者忌服。①《品汇精要》：气虚人忌多服。②《医学入门》：气虚及暴嗽、初泻，不可轻用。③《本草经疏》：咳嗽因于肺有实热，泄泻因于湿热所致，气喘因于火热冲上，带下因于虚热而不因于虚寒，及肠辩初发，湿热正盛，小便不禁因于肾家虚火，法并忌之。④《本草求真》：虚大不宜独用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:石榴皮" label="herb:石榴皮">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="石榴皮" />
          <attvalue for="4" value="507" />
          <attvalue for="5" value="驱虫药" />
          <attvalue for="6" value="涩肠止泻；止血；驱虫；痢疾；肠风下血；崩漏；带下；害虫。主鼻衄；中耳炎；创伤出血；月经不调；红崩白带；牙痛；吐血；久泻；久痢；便血；脱肛；滑精；崩漏；带下；虫积腹痛；疥癣。用于久泻，久痢，便血，脱肛，" />
          <attvalue for="7" value="石榴皮：涩肠止泻；止血；驱虫；痢疾；肠风下血；崩漏；带下；害虫。主鼻衄；中耳炎；创伤出血；月经不调；红崩白带；牙痛；吐血；久泻；久痢；便血；脱肛；滑精；崩漏；带下；虫积腹" />
          <attvalue for="8" value="味酸；涩；性温；小毒。①《药性论》：味酸" />
          <attvalue for="9" value="酸涩温" />
          <attvalue for="10" value="入大肠、肾经。①《雷公炮制药性解》：入大肠、肾二经。②《本草" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="石榴皮碱中毒时，能引起发热、头晕、视物模糊、蚁走感、恶心、呕吐，甚至可招致弱视、腓肠肌痉挛，全身搐搦而虚脱。解决方法：给服通用解毒散或碘酊1毫升，加水至100毫升，洗胃，给与泻盐。抽搐可用巴比妥类，头痛可用阿司匹林，对症治疗。①《本草从新》：能恋膈成痰，痢积未尽者，服之太早，反为害也。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:肉豆蔻" label="herb:肉豆蔻">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="肉豆蔻" />
          <attvalue for="4" value="508" />
          <attvalue for="5" value="温里药" />
          <attvalue for="6" value="温中涩肠；行气消食。主虚泻；冷痢；脘腹胀痛；食少呕吐；宿食不消。治心腹胀痛，虚泻冷痢，呕吐，宿食不消。①《药性论》：能主小儿吐逆不下乳，腹痛；治宿食不消，痰饮。②《海药本草》：主心腹虫痛，脾胃虚冷气并" />
          <attvalue for="7" value="肉豆蔻：温中涩肠；行气消食。主虚泻；冷痢；脘腹胀痛；食少呕吐；宿食不消。治心腹胀痛，虚泻冷痢，呕吐，宿食不消。" />
          <attvalue for="8" value="辛；苦；温。①《药性论》：味苦辛。②《海" />
          <attvalue for="9" value="辛温" />
          <attvalue for="10" value="入肺、大肠经。①《汤液本草》：入手阳明经。②《雷公炮制药性解" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="①《雷公炮炙论》：凡使，勿令犯铜。②《本草经疏》：大肠素有火热及中暑热泄暴注，肠风下血，胃火齿痛及湿热积滞方盛，滞下初起，皆不宜服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
