      <node id="herb:昆布" label="herb:昆布">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="昆布" />
          <attvalue for="4" value="390" />
          <attvalue for="5" value="利水渗湿药" />
          <attvalue for="6" value="消痰软坚；利水退肿。主瘰疬；瘿瘤；噎膈；（疒颓）疝脚气水肿。用于瘿瘤，瘰疬，睾丸肿痛，痰饮水肿。①《别录》：主十二种水肿，瘿瘤聚结气，痿疮。②《药性论》：利水道，去面肿，去恶疮鼠瘘。③《本草拾遗》：主" />
          <attvalue for="7" value="昆布：软坚散结，消痰，利水。用于瘿瘤，瘰疬，睾丸肿痛，痰饮水肿。" />
          <attvalue for="8" value="咸；寒；无毒。①《吴普本草》：酸咸，寒，" />
          <attvalue for="9" value="咸寒" />
          <attvalue for="10" value="归肝、胃、肾经。①《要药分剂》：入胃经。②《本草再新》：入脾" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚寒蕴湿者忌服。①《食疗本草》：下气，久服瘦人。②《品汇精要》：妊娠亦不可服。③《医学入门》：胃虚者慎服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:黄药子" label="herb:黄药子">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="黄药子" />
          <attvalue for="4" value="391" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="散结消瘿；清热解毒；凉血止血。主瘿瘤；喉痹；痈肿疮毒；毒蛇咬伤；肿瘤；吐血；衄血；咯血；百日咳；肺热咳喘。《中华草本》解毒消肿，化痰散结，凉血止血。用于甲状腺肿大，淋巴结结核，咽喉肿痛，吐血，咯血，百" />
          <attvalue for="7" value="黄药子：散结消瘿；清热解毒；凉血止血。主瘿瘤；喉痹；痈肿疮毒；毒蛇咬伤；肿瘤；吐血；衄血；咯血；百日咳；肺热咳喘。解毒消肿，化痰散结，凉血止血。用于甲状腺肿大，淋巴结结核" />
          <attvalue for="8" value="苦、辛，凉。有小毒。①《日华子本草》：凉" />
          <attvalue for="9" value="苦寒" />
          <attvalue for="10" value="肺；肝经。①《本草经疏》：入手少阴、足厥阴经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="内服剂量不宜过大。①《本草经疏》：痈疽已溃不宜服，痈疽发时不焮肿、不渴、色淡、脾胃作泄者，此为阴症，当以内补为急，解毒次之，药子之类宜少服，止可外敷。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:海蛤壳" label="herb:海蛤壳">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="海蛤壳" />
          <attvalue for="4" value="392" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热，利水，化痰，软坚。治热痰喘嗽，水肿，淋病，瘿、瘤，积聚，血结胸痛，血痢，痔疮，崩漏，带下。①《本经》：主咳逆上气，喘息，烦满，胸痛寒热。②《别录》：疗阴痿。③《药性论》：治水气浮肿，下小便，治嗽" />
          <attvalue for="7" value="海蛤壳：清热，利水，化痰，软坚。治热痰喘嗽，水肿，淋病，瘿、瘤，积聚，血结胸痛，血痢，痔疮，崩漏，带下。" />
          <attvalue for="8" value="咸，平。①《本经》：味苦，平。②《吴普本" />
          <attvalue for="9" value="苦咸寒" />
          <attvalue for="10" value="①《本草汇言》：入手足太阳、阳明经。②《要药分剂》：入心、肾" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="气虚有寒、中阳不运者慎用。①《本草经集注》：蜀漆为之使。畏狗胆、甘遂、芫花。②《本草汇言》：病因热邪痰结气闭者宜之，若气虚有寒，中阳不运而为此证者，切勿轻授。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
