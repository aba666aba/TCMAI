      <node id="herb:佩兰" label="herb:佩兰">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="佩兰" />
          <attvalue for="4" value="233" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="解暑化湿；辟秽和中。主感受暑湿；寒热头痛；湿润内蕴；脘痞不饥；恶心呕吐；口中甜腻；消洵。用于湿浊中阻，脘痞呕恶，口中甜腻，口臭，多涎，暑湿表症，头胀胸闷。①《本经》：主利水道，杀蛊毒。②《翟公炮炙论》" />
          <attvalue for="7" value="佩兰：清暑，辟秽，化湿，调经。治感受暑湿，寒热头痛，湿邪内蕴，脘痞不饥，口甘苔腻，月经不调。" />
          <attvalue for="8" value="味辛；性平。①《本经》：味辛，平。②李杲" />
          <attvalue for="9" value="辛平" />
          <attvalue for="10" value="入脾、胃经。①《纲目》：足太阴、厥阴经。②《雷公炮制药性解》" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚、气虚者忌服。①《得配本草》：胃气虚者禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:苍术" label="herb:苍术">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="苍术" />
          <attvalue for="4" value="234" />
          <attvalue for="5" value="祛风湿药" />
          <attvalue for="6" value="燥湿健脾；祛风湿；明目。主湿困脾胃；倦怠嗜卧；胞痞腹胀；食欲不振；哎吐泄泻；痰饮；湿肿；表证夹湿；头身重痛；痹证温性；肢节酸痛重着；痿襞；夜盲①陶弘景：除恶气。②刘完素：明目，暖水脏。③《珍珠囊》：能" />
          <attvalue for="7" value="苍术：燥湿健脾；祛风湿；明目。主湿困脾胃；倦怠嗜卧；胞痞腹胀；食欲不振；哎吐泄泻；痰饮；湿肿；表证夹湿；头身重痛；痹证温性；肢节酸痛重着；痿襞；夜盲" />
          <attvalue for="8" value="味辛；苦；性温①《本草衍义》：气味辛烈。" />
          <attvalue for="9" value="辛苦温" />
          <attvalue for="10" value="归脾；胃；肝经①《珍珠囊》：足阳明、太阴。②《纲目》：入足太" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚内热，气虚多汗者忌服。①《本草经集注》：防风、地榆为之使。②《药性论》：忌桃、李、雀肉、菘菜、青鱼。③《医学入门》：血虚怯弱及七情气闷者慎用。误服耗气血，燥津液，虚火动而痞闷愈甚。④《本草经疏》：凡病属阴虚血少、精不足，内热骨蒸，口干唇燥，咳嗽吐痰、吐血，鼻衄，咽塞，便秘滞下者，法咸忌之。肝肾有动气者勿服。⑤《本草正》：内热阴虚，表疏汗出者忌服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:厚朴" label="herb:厚朴">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="厚朴" />
          <attvalue for="4" value="235" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="行气消积；燥湿除满；降逆平喘。主食积气滞；腹胀便秘；湿阻中焦，脘痞吐泻；痰壅气逆；胸满喘咳。用于湿滞伤中，脘痞吐泻，食积气滞，腹胀便秘，痰饮喘咳。①《本经》:主中风伤寒，头痛，寒热惊悸，气血痹，死肌，" />
          <attvalue for="7" value="厚朴：温中，下气，燥湿，消痰。治胸腹痞满胀痛，反胃，呕吐，宿食不消，痰饮喘咳，寒湿泻痢。" />
          <attvalue for="8" value="苦；辛；性温。①《本经》:味苦，温。②《" />
          <attvalue for="9" value="苦辛温" />
          <attvalue for="10" value="入脾、胃、大肠经。①《雷公炮制药性解》:入脾、胃二经。②《本" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="孕妇慎用。①《本草经集注》:干姜为之使。恶泽泻、寒水石、消石。②《药性论》:忌豆，食之者动气。③《品汇精要》:妊娠不可服。④《本草经疏》:凡呕吐不因寒痰冷积，而由于胃虚火气炎上；腹痛因于血虚脾阴不足，而非停滞所致；泄泻因于火热暴注，而非积寒伤冷；腹满因于中气不足、气不归元，而非气实壅滞；中风由于阴虚火炎、猝致僵仆，而非西北真中寒邪；伤寒发热头疼，而无痞塞胀满之候；小儿吐泻乳食，将成慢惊；大人气虚血" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:砂仁" label="herb:砂仁">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="砂仁" />
          <attvalue for="4" value="236" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="化湿开胃；行气宽中温脾止泻安胎。主湿阻气滞；脘腹胀满；不思饮食；恶心呕吐；腹痛泄泻妊娠恶阻；胎动不安。用于湿浊中阻，脘痞不饥，脾胃虚寒，呕吐泄泻，妊娠恶阻，胎动不安。①《药性论》:主冷气腹痛，止休息气" />
          <attvalue for="7" value="砂仁：化湿开胃；行气宽中温脾止泻安胎。主湿阻气滞；脘腹胀满；不思饮食；恶心呕吐；腹痛泄泻妊娠恶阻；胎动不安" />
          <attvalue for="8" value="味辛；性温。①《药性论》:味苦辛。②《海" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入脾、胃经。①《汤液本草》:入手、足太阴、阳明、太阳，足少阴" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚有热者忌服。①《海药本草》：得诃子、鳖甲、豆蔻、白芜荑等良。②《本草经疏》：凡腹痛属火，泄泻得之暑热，胎动由于血热，咽痛由于火炎，小儿脱肛由于气虚，肿满由于湿热，上气咳嗽由于火冲迫肺而不由于寒气听伤，皆须详察鉴别，难以概用。③《药品化义》：肺有伏火忌之。④《得配本草》：气虚肺满禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:白豆蔻" label="herb:白豆蔻">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白豆蔻" />
          <attvalue for="4" value="237" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="化湿行气；温中止呕；开胃消食。主湿阻气滞；脾胃不和；脘腹胀满；不思饮食；湿温初起；胸闷不饥；胃寒呕吐；食积不消。治气滞，食滞，胸闷，腹胀，噫气，噎膈，吐逆，反胃，疟疾。①《开宝本草》：主积冷气，止吐逆" />
          <attvalue for="7" value="白豆蔻：化湿行气；温中止呕；开胃消食。主湿阻气滞；脾胃不和；脘腹胀满；不思饮食；湿温初起；胸闷不饥；胃寒呕吐；食积不消。治气滞，食滞，胸闷，腹胀，噫气，噎膈，吐逆，反胃，" />
          <attvalue for="8" value="味辛；性温。①《开宝本草》：味辛，大温，" />
          <attvalue for="9" value="辛温" />
          <attvalue for="10" value="入肺、脾经。①《汤液本草》：入手太阴经。②《雷公炮制药性解》" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚血燥而无寒湿者忌服。①《本草经疏》：凡火升作呕，因热腹痛，法咸忌之。②《本草汇言》：凡喘嗽呕吐，不因于寒而因于火者；疟疾不由于瘴邪，而因于阴阳两虚者；目中赤脉白翳，不因于暴病寒风，而因于久眼血虚血热者，皆不可犯。③《本草备要》：肺胃火盛及气虚者禁用。④《本经逢原》：忌见火。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:草豆蔻" label="herb:草豆蔻">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="草豆蔻" />
          <attvalue for="4" value="238" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="温中燥湿；行气健脾。主寒湿阴滞脾胃之脘腹冷痛；痞满作胀，呕吐；泄泻；食谷不化；痰馀；脚气；阐疟；口臭。用于寒湿内阻，脘腹胀满冷痛，嗳气呕逆，不思饮食。（1）健脾燥湿：用于脾胃虚弱或寒湿郁滞引起的食欲不" />
          <attvalue for="7" value="草豆蔻：温中燥湿；行气健脾。主寒湿阴滞脾胃之脘腹冷痛；痞满作胀，呕吐；泄泻；食谷不化；痰馀；脚气；阐疟；口臭。用于寒湿内阻，脘腹胀满冷痛，嗳气呕逆，不思饮食。" />
          <attvalue for="8" value="味辛；性温。①《别录》：味辛，温，无毒。" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="归脾、胃经。①《本草再新》：入心、脾、肺三经。②《汤液本草》" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚血少，津液不足者禁服，无寒湿者慎服。①《本经逢原》：阴虚血燥者忌之。②《本草备要》：忌铁。③《本草经疏》：凡疟不由于瘴气；心痛胃脘痛由于火而不由于寒；湿热瘀滞，暑气外侵而成滞下赤白，里急后重，及泄泻暴注口渴，湿热侵脾，因作胀满，或小水不利，咸属暑气湿热，皆不当用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:草果" label="herb:草果">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="草果" />
          <attvalue for="4" value="239" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="燥湿温中祛痰截疟。主脘腹冷痛；恶心呕吐；胞膈痞满；泄泻泻；下痢；疟疾。用于寒湿内阻，脘腹胀痛，痞满呕吐，疟疾寒热。①李杲:温脾胃，止呕吐，治脾寒湿、寒痰；益真气，消一切冷气膨胀，化疟母，消宿食，解酒毒" />
          <attvalue for="7" value="草果：燥湿除寒，祛痰截疟，消食化乱治疟疾，痰饮痞满，脘腹冷痛，反胃，呕吐，泻痢，食积。" />
          <attvalue for="8" value="味辛；性温。①《饮膳正要》:味辛，性温，" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="归脾、胃经。①《雷公炮制药性解》:入脾、胃二经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="气虚或血亏，无寒湿实邪者忌服。①《本草蒙筌》:大耗元阳，老弱虚羸，切宜戒之。②《本草经疏》:凡疟不由于瘴气；心痛胃脘痛由于火而不由于寒；湿热瘀滞，暑气外侵而成滞下赤白、里急后重及泄泻暴注、口渴；湿热侵脾因作胀满或小水不利，咸属暑气温热，皆不当用。③《本草备要》:忌铁。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:茯苓" label="herb:茯苓">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="茯苓" />
          <attvalue for="4" value="240" />
          <attvalue for="5" value="利水渗湿药" />
          <attvalue for="6" value="渗湿利水；健脾和胃；宁心安神。主小便不利；水肿胀满；痰饮咳逆；呕吐；脾虚食少；泄泻；心悸不安；失眠健忘；遗精白浊。用于水肿尿少，痰饮眩悸，脾虚食少，便溏泄泻，心神不安，惊悸失眠。①《本经》:主胸胁逆气" />
          <attvalue for="7" value="茯苓：渗湿利水，益脾和胃，宁心安神。治小便不利，水肿胀满，痰饮咳逆，呕哕，泄泻，遗精，淋浊，惊悸，健忘。" />
          <attvalue for="8" value="甘；淡；平。①《本经》:味甘，平。②《医" />
          <attvalue for="9" value="甘淡平" />
          <attvalue for="10" value="入心、脾、肺经。①《汤液本草》:入手大阴，足大阳、少阳经。②" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="虚寒精滑或气虚下陷者忌服。①《本草经集注》:马蔺为之使。恶白敛。畏牡蒙、地榆、雄黄、秦艽、龟甲。②《药性论》:忌米醋。③张元素:如小便利或数，服之则损人目。如汗多入服之，损元气。④《本草经疏》:病人肾虚，小水自利或不禁或虚寒精清滑，皆不得服。⑤《得配本草》:气虚下陷、水涸口干俱禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="category:利水渗湿药" label="category:利水渗湿药">
        <attvalues>
          <attvalue for="0" value="Category" />
