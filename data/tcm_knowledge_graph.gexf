          <attvalue for="10" value="入肝、肾经。①《纲目》:入厥阴。②《本草经疏》:入肝、肾。③" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="《本草从新》:无寒湿滞气者勿服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
