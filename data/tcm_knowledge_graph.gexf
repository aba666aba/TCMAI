      <node id="herb:白茅根" label="herb:白茅根">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白茅根" />
          <attvalue for="4" value="6" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="凉血止血；清热生津；利尿通淋。主血热出血；热病烦渴；胃热呕逆；肺热喘咳；小便淋沥涩痛；水肿；黄疸。用于血热吐血，衄血，尿血，热病烦渴，黄疸，水肿，热淋涩痛；急性肾炎水肿。①《本经》：主劳伤虚羸，补中益" />
          <attvalue for="7" value="白茅根：凉血，止血，清热，利尿。治热病烦渴，吐血，衄血，肺热喘急，胃热哕逆，淋病，小便不利，水肿，黄疸。" />
          <attvalue for="8" value="甘、寒。①《本经》：味甘，寒。②《别录》" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="入肺、胃、小肠经。①《滇南本草》：入胃、小肠二经。②《本草经" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚寒，溲多不渴者忌服。①《本草经疏》：因寒发哕，中寒呕吐，湿痰停饮发热，并不得服。②《本草从新》：吐血因于虚寒者，非所宜也。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
