      <node id="herb:溪黄草" label="herb:溪黄草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="溪黄草" />
          <attvalue for="4" value="269" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热利湿，凉血散瘀。治急性肝炎，急性胆囊炎，痢疾，肠炎，癃闭，跌打瘀肿。①广州部队《常用中草药手册》：清热，利湿，退黄。治急性黄疸型肝炎，急性胆囊炎。②《常用中草药彩色图谱》：清肝利胆，退黄祛湿，凉血" />
          <attvalue for="7" value="溪黄草：清热解毒；利湿退黄；散瘀消肿。主湿热黄疽；胆囊炎；泄泻；疮肿；跌打伤痛" />
          <attvalue for="8" value="味苦；性寒。①广州部队《常用中草药手册》" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="归肝；胆；大肠经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚寒者慎服。" />
