      <node id="herb:西洋参" label="herb:西洋参">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="西洋参" />
          <attvalue for="4" value="443" />
          <attvalue for="5" value="止血药" />
          <attvalue for="6" value="补气养阴；清火生津。主气虚阴专火旺，咳嗽痰血，虚热烦烦倦，内热消渴，口燥烟干。用于气虚阴亏，内热，咳喘痰血，虚热烦倦，消渴，口燥咽干。①《本草从新》：补肺降火，生津液，除烦倦。虚而有火者相宜。②《药性" />
          <attvalue for="7" value="西洋参：补气养阴；清火生津。主气虚阴专火旺，咳嗽痰血，虚热烦烦倦，内热消渴，口燥烟干。" />
          <attvalue for="8" value="味甘；微苦；性寒①《本草从新》：苦微甘，" />
          <attvalue for="9" value="苦、微甘" />
          <attvalue for="10" value="归肺；胃；心；肾经①《本草再新》：入心、肺、肾三经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="中阳衰微，胃有寒湿者忌服。不宜与藜芦同用。①《本草从新》：脏寒者服之，即作腹痛，郁火服之，火不透发，反生寒热。②《纲目拾遗》：忌铁器及火炒。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:党参" label="herb:党参">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="党参" />
          <attvalue for="4" value="444" />
          <attvalue for="5" value="补气药" />
          <attvalue for="6" value="健脾补肺、益气生津。主脾胃虚弱、食少便溏、四肢乏力、肺虚喘咳、气短自汗、气微两亏诸证。用于脾肺虚弱，气短心悸，食少便溏，虚喘咳嗽，内热消渴。①《本经逢原》：清肺。②《本草从新》：补中益气，和脾胃，除烦" />
          <attvalue for="7" value="党参：补中，益气，生津。治脾胃虚弱，气血两亏，体倦无力，食少，口渴，久泻，脱肛。" />
          <attvalue for="8" value="味甘；性平。①《本经逢原》：甘，平。②《" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="归脾；肺经。①《得配本草》：入手、足太阴经气分。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="实证、热证禁服；正虚邪实证，不宜单独应用。不宜与藜芦同用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:太子参" label="herb:太子参">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="太子参" />
          <attvalue for="4" value="445" />
          <attvalue for="5" value="补气药" />
          <attvalue for="6" value="补益脾肺；益气生津。主脾胃虚弱；食欲不振；倦怠无力；气阴两伤；干咳痰少；自汗气短；以及温病后期气虚津伤；内热口渴；或神经衰弱，心悸失眠，头昏健忘，小儿夏季热。用于脾虚体弱、病后虚弱、气阴不足、自汗口渴" />
          <attvalue for="7" value="太子参：益气健脾，生津润肺。用于脾虚体弱、病后虚弱、气阴不足、自汗口渴、肺噪干咳。" />
          <attvalue for="8" value="甘；微苦；性微寒。①《本草再新》：味甘，" />
          <attvalue for="9" value="甘、微苦" />
          <attvalue for="10" value="归脾、肺经。①《本草再新》：入心、脾、肺三经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="表实邪盛者不宜用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:白术" label="herb:白术">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白术" />
          <attvalue for="4" value="447" />
          <attvalue for="5" value="化湿药" />
          <attvalue for="6" value="健脾益气；燥湿利水；止汗；安胎。主脾气虚弱；神疲乏力；食少少腹胀；大便溏薄；水饮内停；小便不利；水肿；痰饮眩晕；温痹酸痛；气虚自汗；胎动不安。用于脾虚食少，腹胀泄泻，痰饮眩悸，水肿，自汗，胎动不安。土" />
          <attvalue for="7" value="白术：补脾，益胃，燥湿，和中，安胎。治脾胃气弱，不思饮食，倦怠少气，虚胀，泄泻，痰饮，水肿，黄疸，湿痹，小便不利，头晕，自汗，胎气不安。" />
          <attvalue for="8" value="味苦；甘；性温。①《本经》：味苦，温。②" />
          <attvalue for="9" value="苦、甘" />
          <attvalue for="10" value="归脾；胃经。①《汤液本草》：入手太阳、少阴，足阳明、太阴，少" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚燥渴，气滞胀闷者忌服。①《本草经集注》：防风、地榆为之使。②《药品化义》：凡郁结气滞，胀闷积聚，吼喘壅塞，胃痛由火，痈疽多脓，黑瘦人气实作胀，皆宜忌用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
