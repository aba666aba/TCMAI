      <node id="herb:薏苡仁" label="herb:薏苡仁">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="薏苡仁" />
          <attvalue for="4" value="8" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="利湿健脾；舒筋除痹；清热排脓。主水肿；脚气；小便淋沥；湿温病；泄泻带下；风湿痹痛；筋脉拘挛；肺痈；肠痈；扁平疣。用于水肿，脚气，小便不利，湿痹拘挛，脾虚泄泻，肺痈，肠痈；扁平疣。①《本经》；主筋急拘挛" />
          <attvalue for="7" value="薏苡仁：利湿健脾；舒筋除痹；清热排脓。主水肿；脚气；小便淋沥；湿温病；泄泻带下；风湿痹痛；筋脉拘挛；肺痈；肠痈；扁平疣。用于水肿，脚气，小便不利，湿痹拘挛，脾虚泄泻，肺痈" />
          <attvalue for="8" value="甘；淡；微寒。①《本经》：味甘，微寒。②" />
          <attvalue for="9" value="淡、甘" />
          <attvalue for="10" value="入脾、肺、肾经。①《纲目》：阳明。②《雷公炮制药性解》：入肺" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾约便难及妊妇慎服。①《本草经疏》：凡病大便燥，小水短少，因寒转筋，脾虚无湿者忌之。妊娠禁用。②《本草通玄》：下利虚而下陷者，非其宜也。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
      <node id="herb:甘草" label="herb:甘草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="甘草" />
          <attvalue for="4" value="9" />
          <attvalue for="5" value="其他" />
          <attvalue for="6" value="益气补中；缓急止痛；润肺止咳；泻火解毒；调和诸药。主倦怠食少；肌瘦面黄；心悸气短；腹痛便溏；四肢挛急疼痛；脏躁；咳嗽气喘；咽喉肿痛；痈疮肿痛；小儿胎毒；及药物、食物中毒。（摘录《中华草本》）清热解毒，" />
          <attvalue for="7" value="甘草：益气补中；缓急止痛；润肺止咳；泻火解毒；调和诸药。主倦怠食少；肌瘦面黄；心悸气短；腹痛便溏；四肢挛急疼痛；脏躁；咳嗽气喘；咽喉肿痛；痈疮肿痛；小儿胎毒；及药物、食物" />
          <attvalue for="8" value="甘，平。①《本经》：味甘，平。②《别录》" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="入脾、胃、肺经。①《汤液本草》：入足厥阴、太阴、少阴经。②《" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="实证中满腹胀忌服。不宜与甘遂、大戟、芫花、海藻同用。①《药品化义》：味厚而太甜，补药中不宜多用，恐恋膈不思食也。②《本草正》：中满者勿加，恐其作胀，速下者勿入，恐其缓功。③《本草经集注）：术，干漆、苦参为之使。恶远志。反大戟、芫花、甘遂、海藻四物。④《医学入门》：痢疾初作，不可用。" />
          <attvalue for="13" value="1 - 副本 (3).txt" />
        </attvalues>
      </node>
