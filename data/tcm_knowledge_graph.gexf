      <node id="herb:赤小豆" label="herb:赤小豆">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="赤小豆" />
          <attvalue for="4" value="244" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="利水消肿退黄；清热解毒消痈。主水肿；脚气；黄疸；淋病；便血；肿毒疮疡；癣疹。利水消肿，解毒排脓。用于水肿胀满，脚气肢肿，黄疸尿赤，风湿热痹，痈肿疮毒，肠痈腹痛。①《本经》：主下水，排痈肿脓血。②《纲目" />
          <attvalue for="7" value="赤小豆的功效：利水消肿退黄；清热解毒消痈。主水肿；脚气；黄疸；淋病；便血；肿毒疮疡；癣疹。利水消肿，解毒排脓。用于水肿胀满，脚气肢肿，黄疸尿赤，风湿热痹，痈肿疮毒，肠痈腹" />
          <attvalue for="8" value="味甘；酸；性微寒。①《别录》：甘酸，平，" />
          <attvalue for="9" value="甘" />
          <attvalue for="10" value="归心、小肠经。①《雷公炮制药性解》：入心经。②《本草新编》：" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="①陶弘景：性逐津液，久食令人枯燥。②《食性本草》：久食瘦人。③《随息居饮食谱》：蛇咬者百日内忌之。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:冬瓜皮" label="herb:冬瓜皮">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="冬瓜皮" />
          <attvalue for="4" value="245" />
          <attvalue for="5" value="利水渗湿药" />
          <attvalue for="6" value="清热利水；消肿。主水肿；小便不利；泄泻；疮肿。利尿消肿。用于水肿胀满，小便不利，暑热口渴，小便短赤。①《本草图经》：功用与冬瓜等。②《纲目》：主驴马汗入疮肿痛，阴干为末涂之，又主折伤损痛。③《滇南本草" />
          <attvalue for="7" value="冬瓜皮：清热利水；消肿。主水肿；小便不利；泄泻；疮肿。利尿消肿。用于水肿胀满，小便不利，暑热口渴，小便短赤。" />
          <attvalue for="8" value="味甘；性微寒。①《滇南本草》：性微寒平，" />
          <attvalue for="9" value="甘微寒" />
          <attvalue for="10" value="归脾、小肠经。①《滇南本草》：入脾、肺二经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="《四川中药志》：因营养不良而致之虚肿慎用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:玉米须" label="herb:玉米须">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="玉米须" />
          <attvalue for="4" value="246" />
          <attvalue for="5" value="利水渗湿药" />
          <attvalue for="6" value="利尿消肿；清肝利胆。主水肿；小便淋沥；黄疸；胆囊炎；胆结石；高血压；糖尿病；乳汁不通。用于急、慢性肾炎，水肿，急、慢性肝炎，高血压，糖尿病，慢性鼻窦炎，尿路结石，胆道结石，小便不利、湿热黄胆等症。并可" />
          <attvalue for="7" value="玉米须：利尿，泄热，平肝，利胆。治肾炎水肿，脚气，黄疸肝炎，高血压，胆囊炎，胆结石，糖尿病，吐血衄血，鼻渊，乳痈。" />
          <attvalue for="8" value="味甘；淡；性平。①《滇南本草》：性微温，" />
          <attvalue for="9" value="甘平" />
          <attvalue for="10" value="归膀胱、肝、胆经。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="不作药用时勿服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
