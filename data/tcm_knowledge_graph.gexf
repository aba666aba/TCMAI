      <node id="herb:连翘" label="herb:连翘">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="连翘" />
          <attvalue for="4" value="128" />
          <attvalue for="5" value="解表药" />
          <attvalue for="6" value="清热解毒；消肿散结 风热感冒。主风热感冒；温病；热淋尿闭；痈疽；肿毒；瘰疬；瘿瘤；喉痹。用于痈疽，瘰疠，乳痈，丹毒，风热感冒，温病初起，温热入营，高热烦渴，神昏发斑，热淋尿闭。①《本经》：主寒热，鼠痿" />
          <attvalue for="7" value="连翘：清热，解毒，散结，消肿。治温热，丹毒，斑疹，痈疡肿毒，瘰疬，小便淋闭。" />
          <attvalue for="8" value="苦；性微寒。①《本经》：味苦，平。②《别" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入心、肝、胆经。①《汤液本草》：手足少阳、阳明经。②《纲目》" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚弱，气虚发热，痈疽已溃、脓稀色淡者忌服。①《本草经疏》：痈疽巳溃勿服，大热由于虚者勿服，脾胃薄弱易于作泄者勿服。②《本草通玄》：久服有寒中之患。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:大青叶" label="herb:大青叶">
        <attvalues>
