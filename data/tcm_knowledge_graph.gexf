          <attvalue for="4" value="151" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热除湿；泄浊解毒；通利关节。主梅毒；淋浊；泄泻；筋骨挛痛；脚气；痈肿；疮癣；瘰疬；瘿瘤及汞中毒。①《本草拾遗》：调中止泄。②《本草图经》：敷疮毒。③《滇南本草》：治五淋白浊，兼治杨梅疮毒、丹毒。④《" />
          <attvalue for="7" value="土茯苓：清热除湿；泄浊解毒；通利关节。主梅毒；淋浊；泄泻；筋骨挛痛；脚气；痈肿；疮癣；瘰疬；瘿瘤及汞中毒。" />
          <attvalue for="8" value="甘淡，平。①《本草图经》：味甘，性凉，无" />
          <attvalue for="9" value="甘淡" />
          <attvalue for="10" value="入肝、胃经。①《纲目》：为阳明本药。②《本草通玄》：入胃、肝" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="肝肾阴亏者慎服。①《万氏家抄方》：不犯铁器。②《纲目》：服时忌茶。③《本草从新》：肝肾阴亏者勿服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:白蔹" label="herb:白蔹">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白蔹" />
          <attvalue for="4" value="152" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热解毒；散结止痛；生肌敛疮。主疮疡肿毒；瘰疬；烫伤；湿疮；温疟；惊痫；血痢；肠风；痔漏；白带；跌打损伤；外伤出血。①《本经》：主痈肿疽疮，散结气，止痛。除热，目中赤，小儿惊痫，温疟，女子阴中肿痛。②" />
          <attvalue for="7" value="白蔹：清热，解毒，散结，生肌，止痛，治痈肿，疔疮，瘰疬，烫伤，温疟，惊痫，血痢，肠风，痔漏。" />
          <attvalue for="8" value="苦；辛；性微寒。①《本经》：味苦，平。②" />
          <attvalue for="9" value="苦辛" />
          <attvalue for="10" value="入心、肝、脾经。①《滇南本草》：入脾、肺二经。②《本草求真》" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚寒及无实火者，痈疽已溃者均不宜服。阴疽色淡不起，胃气弱者，也不宜服用。①《本草经集注》：代赭为使。反乌头。②《本草经疏》：痈疽已溃者不宜服。③《本经逢原》：阴疽色淡不起，胃气弱者，非其所宜。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:白头翁" label="herb:白头翁">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="白头翁" />
          <attvalue for="4" value="153" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="清热解毒；凉血止痢；燥湿杀虫。主赤白痢疾；鼻衄；崩漏；血痔；寒热温疟；带下；阴痒；湿疹；瘰疬；痈疮；眼目赤痛。用于热毒血痢，阴痒带下，阿米巴痢。①《本经》：主温疟狂易寒热，癥瘕积聚，瘿气，逐血止痛，金" />
          <attvalue for="7" value="白头翁：清热解毒；凉血止痢；燥湿杀虫。主赤白痢疾；鼻衄；崩漏；血痔；寒热温疟；带下；阴痒；湿疹；瘰疬；痈疮；眼目赤痛。用于热毒血痢，阴痒带下，阿米巴痢。" />
          <attvalue for="8" value="味苦；性寒。①《本经》：味苦，温，无毒。" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入大肠、肝、胃经。①《雷公炮制药性解》：入心、肾二经。②《本" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="虚寒泻痢忌服。①《药性论》：豚实为使。②《日华子本草》：得酒良。③《本草经疏》：滞下胃虚不思食，及下利完谷不化，泄泻由于虚寒寒湿，而不由于湿毒者忌之。④《本草从新》：血分无热者忌。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:马齿苋" label="herb:马齿苋">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="马齿苋" />
