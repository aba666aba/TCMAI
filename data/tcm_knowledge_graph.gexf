      <node id="herb:川芎" label="herb:川芎">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="川芎" />
          <attvalue for="4" value="345" />
          <attvalue for="5" value="理气药" />
          <attvalue for="6" value="行气开郁，法风燥湿，活血止痛。治风冷头痛旋晕，胁痛腹疼，寒痹筋挛，经闭，难产，产后瘀阻块痛，痈疽疮疡。用于月经不调，经闭痛经，瘕腹痛，胸胁刺痛，跌扑肿痛，头痛，风湿痹痛。①《本经》：主中风入脑头痛，寒" />
          <attvalue for="7" value="川芎：活血行气，祛风止痛。用于月经不调，经闭痛经，癥瘕腹痛，胸胁刺痛，跌扑肿痛，头痛，风湿痹痛。" />
          <attvalue for="8" value="味辛；性温。①《本经》：味辛，温。②《吴" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入肝、胆经。①《汤液本草》：入手足厥阴经、少阳经。②《药品化" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚火旺，上盛下虚及气弱之人忌服。1.《本草经集注》：白芷为之使。恶黄连。2.《品汇精要》：久服则走散真气。3.《本草蒙筌》：恶黄芪、山茱、狼毒。畏硝石、滑石、黄连。反藜芦。4.《本草经疏》：凡病人上盛下虚，虚火炎上，呕吐咳嗽，自汗、盗汗咽干口燥，发热作渴烦躁，法并忌之。5.《本草从新》：气升痰喘不宜用。6.《得配本草》：火剧中满，脾虚食少，火郁头痛皆禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:延胡索" label="herb:延胡索">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="延胡索" />
          <attvalue for="4" value="346" />
          <attvalue for="5" value="理气药" />
          <attvalue for="6" value="活血；散瘀；理气；止痛。主心腹腰膝诸痛；月经不调；症瘕；崩中；产后血晕；恶露不尽；跌打损伤。用于胸胁、脘腹疼痛，经闭痛经，产后瘀阻，跌扑肿痛。①《雷公炮炙论》：治心痛欲死。②《日华子本草》：除风，治气" />
          <attvalue for="7" value="延胡索：活血；散瘀；理气；止痛。主心腹腰膝诸痛；月经不调；症瘕；崩中；产后血晕；恶露不尽；跌打损伤。用于胸胁、脘腹疼痛，经闭痛经，产后瘀阻，跌扑肿痛。" />
          <attvalue for="8" value="辛；苦；温；无毒。①《海药本草》：味苦甘" />
          <attvalue for="9" value="辛苦温" />
          <attvalue for="10" value="入肝、胃经。①《汤液本草》：入手足太阴经。②《本草蒙筌》：入" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="血热气虚及孕妇忌服。①《品汇精要》：妊娠不可服。②《本草经疏》：经事先期及一切血热为病，法所应禁。③《本草正》：产后血虚或经血枯少不利，气虚作痛者，皆大非所宜。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:郁金" label="herb:郁金">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="郁金" />
          <attvalue for="4" value="347" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="活血止能；行气解郁；清心凉血；疏肝利胆。主胸腹胁肋诸痛；妇女痛经；经闭；症瘕结块；热病神昏；癫狂；惊痫；吐血；衄备；血淋；砂淋；黄疸。用于经闭痛经,胸腹胀痛、刺痛，热病神昏，癫痫发狂，黄疸尿赤。①《药" />
          <attvalue for="7" value="郁金：行气化瘀，清心解郁，利胆退黄。用于经闭痛经,胸腹胀痛、刺痛，热病神昏，癫痫发狂，黄疸尿赤。" />
          <attvalue for="8" value="味辛；苦；性寒。①《唐本草》：味辛苦，寒" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="入心、肺、肝经。①《纲目》：入心及包络。②《雷公炮制药性解》" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚失血及无气滞血瘀者忌服，孕妇慎服。①《本草经疏》凡病属真阴虚极，阴分火炎，薄血妄行，溢出上窍，而非气分拂逆，肝气不平，以致伤肝吐血者不宜用也。即用之亦无效。②《本草汇言》：胀满，膈逆，疼痛，关乎胃虚血虚者，不宜用也。③《得配本草》：气虚胀滞禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:姜黄" label="herb:姜黄">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="姜黄" />
          <attvalue for="4" value="348" />
          <attvalue for="5" value="解表药" />
          <attvalue for="6" value="破血行气；通经止痛。主血瘀气滞诸证；胞腹胁痛；妇女痛经；闭经；产后瘀滞腹痛；风湿痹痛；跌打损伤；痈肿。用于气滞血瘀的胸腹痛、痛经及肢体疼痛，常配元胡、香附。①《唐本草》：主心腹结积，疰忤，下气，破血，" />
          <attvalue for="7" value="姜黄：破血行气；通经止痛。主血瘀气滞诸证；胞腹胁痛；妇女痛经；闭经；产后瘀滞腹痛；风湿痹痛；跌打损伤；痈肿。" />
          <attvalue for="8" value="辛苦，温。①《唐本草》：味辛苦，大寒，无" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="入脾、肝经。①《纲目》：入心、脾。②《雷公炮制药性解》：入心" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="血虚而无气滞血瘀者忌服。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:乳香" label="herb:乳香">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="乳香" />
          <attvalue for="4" value="349" />
          <attvalue for="5" value="利水渗湿药" />
          <attvalue for="6" value="活血行气；通经止痛；消肿生肌。主心腹疼痛；风湿痹痛；经闭痛经；跌打瘀痛；痈疽肿毒；肠痈；疮溃不敛。治气血凝滞、心腹疼痛，痈疮肿毒，跌打损伤，痛经，产后瘀血刺痛。①《别录》：疗风水毒肿，去恶气。疗风瘾疹" />
          <attvalue for="7" value="乳香：活血行气；通经止痛；消肿生肌。主心腹疼痛；风湿痹痛；经闭痛经；跌打瘀痛；痈疽肿毒；肠痈；疮溃不敛。" />
          <attvalue for="8" value="味辛；苦；微温。①《别录》：微温。②《日" />
          <attvalue for="9" value="辛苦温" />
          <attvalue for="10" value="入心、肝、脾经。①朱震亨：入手少阴经。②《本草经疏》：入足太" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="孕妇忌服。①《本草经疏》：痈疽已溃不宜服，诸疮脓多时，未宜遽用。②《本经逢原》：胃弱勿用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:没药" label="herb:没药">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="没药" />
          <attvalue for="4" value="350" />
          <attvalue for="5" value="利水渗湿药" />
          <attvalue for="6" value="活血止痛；消肿生肌。主胸腹瘀痛；痛经；经闭；症瘕；跌打损伤；痈肿疮疡；肠痈；目赤肿痛。用于跌打淤血肿痛，痈疽肿痛，胸腹诸痛；外用治疮口久不收敛。①《药性论》：主打搕损，心腹血瘀，伤折踒跌，筋骨瘀痛，金" />
          <attvalue for="7" value="没药：散血去瘀，消肿定痛。治跌损，金疮，筋骨，心腹诸痛，癥瘕，经闭，痈疽肿痛，痔漏，目障，" />
          <attvalue for="8" value="苦，平。①《药性论》：味苦辛。②《海药本" />
          <attvalue for="9" value="苦辛平" />
          <attvalue for="10" value="入肝经。①《本草经疏》：入足厥阴经。②《本草新编》：入脾、肾" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="孕妇忌服。①《品汇精要》：妊娠不可服。②《本草经疏》：凡骨节痛与夫胸腹胁肋痛，非瘀血停留而因于血虚者不宜用。产后恶霹去多，腹中虚痛者不宜用。痈疽已溃不宜用。目赤肤翳非血热甚者不宜用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:丹参" label="herb:丹参">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="丹参" />
          <attvalue for="4" value="351" />
          <attvalue for="5" value="清热药" />
          <attvalue for="6" value="祛瘀止痛，活血通经，清心除烦。用于月经不调，经闭痛经，癥瘕积聚，胸腹刺痛，热痹疼痛，疮疡肿痛，心烦不眠；肝脾肿大，心绞痛。①《本经》：主心腹邪气，肠鸣幽幽如走水，寒热积聚；破癥除瘕，止烦满，益气。②《" />
          <attvalue for="7" value="丹参：活血祛瘀，安神宁心，排脓，止痛。治心绞痛，月经不调，痛经，经闭，血崩带下，癥瘕，积聚，瘀血腹痛，骨节疼痛，惊悸不眠，恶疮肿毒。" />
          <attvalue for="8" value="苦，微温。①《本经》；味苦，微寒，无毒。" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入心、肝经。①《纲目》：手少阴、厥阴血分药。②《本草经疏》：" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="无瘀血者慎服。①《本草经集庄》：畏咸水。反藜芦。②《本草经疏》：妊娠无故勿服。③《本草备要》：忌醋。④《本经逢原》：大便不买者忌之。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:牛膝" label="herb:牛膝">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="牛膝" />
          <attvalue for="4" value="355" />
          <attvalue for="5" value="利水渗湿药" />
          <attvalue for="6" value="活血通经，补肝肾，强筋骨，引火（血）下行，利尿通淋" />
