      <node id="patent:8. 清开灵注射液" label="patent:8. 清开灵注射液">
        <attvalues>
          <attvalue for="0" value="PatentMedicine" />
          <attvalue for="1" value="8. 清开灵注射液" />
          <attvalue for="4" value="108" />
          <attvalue for="5" value="二、清热类中成药" />
          <attvalue for="17" value="" />
          <attvalue for="19" value="清热解毒，化痰通络，醒神开窍。" />
          <attvalue for="7" value="热病神昏，中风偏瘫，神志不清，急、慢性肝炎，乙型肝炎，上呼吸道感染，肺炎，高烧，以及脑血栓形成，脑出血见上述证候者。" />
          <attvalue for="11" value="肌内注射：2～4ml/日。 重症患者静脉滴注：20～40ml/日，以10％葡萄糖注射液200ml或生理盐水注射液100ml稀释后使用。" />
          <attvalue for="12" value="不能与下列药物如硫酸的庆大霉素、青霉素G、肾上腺素，阿拉明、乳糖酸红霉素、多巴胺等合用。有表证恶寒发热者、药物过敏者慎用。出现过敏反应及时停药并做脱敏处理。本品产生沉淀或混浊时不得使用。稀释以后，必须在4小时以内使用。输液速度：注意滴速勿快，儿童以20～40滴/分为宜，成年人以40～60滴/分为宜。除按[用法用量]中说明使用以外，还可用5%葡萄糖注射液、氯化钠注射液按每10ml药液加入100ml溶液稀释后使用。" />
        </attvalues>
      </node>
      <node id="patent:9.  醒脑静注射液" label="patent:9.  醒脑静注射液">
        <attvalues>
          <attvalue for="0" value="PatentMedicine" />
          <attvalue for="1" value="9.  醒脑静注射液" />
          <attvalue for="4" value="109" />
          <attvalue for="5" value="三、祛暑类中成药" />
          <attvalue for="17" value="" />
          <attvalue for="19" value="醒神止痉，清热凉血，行气活血，解毒止痛。" />
          <attvalue for="7" value="温热病、热邪内陷心包、蒙闭心窍、气营两燔、营血火毒等证。" />
          <attvalue for="11" value="肌内注射： 2～4ml/次，1～2次/日。静脉滴注： 10～20ml/次，用5%～10%葡萄糖或稀释后使用。" />
          <attvalue for="12" value="本品芳香易挥发，开启后尽快使用，否则影响药效。" />
        </attvalues>
      </node>
