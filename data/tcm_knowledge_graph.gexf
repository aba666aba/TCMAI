      <node id="herb:牡丹皮" label="herb:牡丹皮">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="牡丹皮" />
          <attvalue for="4" value="1030" />
          <attvalue for="5" value="清热凉血药" />
          <attvalue for="6" value="清热；活血散瘀。主温热病热入血分；发斑；吐衄；热泪盈眶病菌后期热伏阴分发热；阴虚骨蒸潮热；血滞经闭；痛经；痈肿疮毒；跌扑伤痛；风湿热痹。用于温毒发斑，吐血衄血，夜热早凉，无汗骨蒸，经闭痛经，痈肿疮毒，" />
          <attvalue for="7" value="牡丹皮：清热；活血散瘀。主温热病热入血分；发斑；吐衄；热泪盈眶病菌后期热伏阴分发热；阴虚骨蒸潮热；血滞经闭；痛经；痈肿疮毒；跌扑伤痛；风湿热痹" />
          <attvalue for="8" value="辛苦；凉；微寒。①《本经》：味辛，寒。②" />
          <attvalue for="9" value="苦、辛" />
          <attvalue for="10" value="入心、肝、肾经。①《珍珠囊》：手厥阴、足少阴。②《纲目》：手" />
          <attvalue for="11" value="煎服，6-12g" />
          <attvalue for="12" value="血虚有寒，孕妇及月经过多者慎服。①《本草经集注》：畏菟丝子。②《古今录验方》：忌胡荽。③《唐本草》：畏贝母、大黄。④《日华子本草》：忌蒜。⑤《本经逢原》：自汗多者勿用，为能走泄津液也。痘疹初起勿用，为其性专散血.不无根脚散阔之虑。⑥《得配本草》：胃气虚寒，相火衰者，勿用。" />
          <attvalue for="13" value="《中药学》教材" />
        </attvalues>
      </node>
      <node id="herb:益智仁" label="herb:益智仁">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="益智仁" />
          <attvalue for="4" value="1031" />
          <attvalue for="5" value="补阳药" />
          <attvalue for="6" value="温脾止泻摄涎；暖肾缩尿固精。主脾胃虚寒；呕吐；泄泻；腹中冷育；口多唾涎；肾虚遗尿；尿频；遗精；白浊。治冷气腹痛，中寒吐泻，多唾，遗精，小便余沥，夜多小便。①《广志》：含之摄涎秽。②《本草拾遗》：止呕哕" />
          <attvalue for="7" value="益智仁：温脾止泻摄涎；暖肾缩尿固精。主脾胃虚寒；呕吐；泄泻；腹中冷育；口多唾涎；肾虚遗尿；尿频；遗精；白浊。治冷气腹痛，中寒吐泻，多唾，遗精，小便余沥，夜多小便。" />
          <attvalue for="8" value="味辛；性温。①《南方草木状》：味辛。②陶" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入脾，肾经。①《汤液本草》：手、足太阴经，足少阴经。②《雷公" />
          <attvalue for="11" value="煎服，3-10g" />
          <attvalue for="12" value="阴虚火旺或因热而患遗滑崩带者忌服。①《本草经疏》：凡呕吐由于热而不因于寒；气逆由于怒而不因于虚；小便余沥由于水涸精亏内热，而不由于肾气虚寒；泄泻由于湿火暴注，而不由于气虚肠滑，法并禁之。②《本草备要》：因热而崩、浊者禁用。’③《本经逢原》：血燥有火、不可误用。" />
          <attvalue for="13" value="《中药学》教材" />
        </attvalues>
      </node>
      <node id="herb:合欢皮" label="herb:合欢皮">
