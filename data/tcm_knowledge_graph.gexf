      <node id="herb:凤尾草" label="herb:凤尾草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="凤尾草" />
          <attvalue for="4" value="1126" />
          <attvalue for="5" value="民间草药" />
          <attvalue for="6" value="清热利湿；凉血止血；消肿解毒。主痢疾；泄泻；淋浊；带下；黄疸；疔疮肿毒；喉痹乳蛾；淋巴结核；腮腺炎；乳腺炎；高热抽搐；蛇虫咬伤；吐血；衄血；尿血；便血；外伤出血。①《生草药性备要》：洗疳、疗、痔，散毒" />
          <attvalue for="7" value="凤尾草：清热利湿；凉血止血；消肿解毒。主痢疾；泄泻；淋浊；带下；黄疸；疔疮肿毒；喉痹乳蛾；淋巴结核；腮腺炎；乳腺炎；高热抽搐；蛇虫咬伤；吐血；衄血；尿血；便血；外伤出血。" />
          <attvalue for="8" value="味淡微苦，性寒。①《生草药性备要》：味辛" />
          <attvalue for="9" value="微苦" />
          <attvalue for="10" value="大肠；心；肝经。①《泉州本草》：入肾、胃二经。②《闽东本草》" />
          <attvalue for="11" value="煎服，9-15g" />
          <attvalue for="12" value="虚寒证忌服。①《履崭岩本草》：老人不可多服，其性冷故也。②《闽东本草》：孕妇、冷痢、休息痢不宜服。" />
          <attvalue for="13" value="V4系统扩充" />
        </attvalues>
      </node>
      <node id="herb:马鞭草" label="herb:马鞭草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="马鞭草" />
          <attvalue for="4" value="1127" />
          <attvalue for="5" value="民间草药" />
          <attvalue for="6" value="清热解毒；活血通经；利水消肿；截疟。主感冒发热；咽喉肿痛；牙龈肿痛；黄疸；痢疾；血瘀经闭；痛经；症瘕；水肿；小便不利；疟疾；痈疮肿毒；跌打损伤。用于癥瘕积聚，经闭痛经，疟疾，喉痹，痈肿，水肿，热淋。①" />
          <attvalue for="7" value="马鞭草：清热解毒，活血散瘀，利水消肿。治外感发热，湿热黄疸，水肿，痢疾，疟疾，白喉，喉痹，淋病，经闭，癥瘕，痈肿疮毒，牙疳。" />
          <attvalue for="8" value="苦；辛；微寒。①《药性论》：味苦，有毒。" />
          <attvalue for="9" value="苦" />
          <attvalue for="10" value="入肝、脾经。①《雷公炮制药性解》：入肝、脾二经。②《得配本草" />
          <attvalue for="11" value="煎服，5-10g" />
          <attvalue for="12" value="孕妇慎服。①《本草经疏》：病人虽有湿热血热证，脾阴虚而胃气弱者勿服。②《本草从新》：疮证久而虚者，斟酌用之。" />
          <attvalue for="13" value="V4系统扩充" />
        </attvalues>
      </node>
      <node id="herb:鸭跖草" label="herb:鸭跖草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="鸭跖草" />
