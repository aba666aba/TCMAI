      <node id="herb:枳实" label="herb:枳实">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="枳实" />
          <attvalue for="4" value="285" />
          <attvalue for="5" value="化痰止咳平喘药" />
          <attvalue for="6" value="破气，散痞，泻痰，消积。治胸腹胀满，胸痹，痞痛，痰癖，水肿，食积，便秘，胃下垂，子宫下垂，脱肛。①《本经》:主大风在皮肤中，如麻豆苦痒，除寒热结，止痢，长肌肉，利五脏。②《别录》:除胸胁痰癖，逐停水，" />
          <attvalue for="7" value="枳实：破气，散痞，泻痰，消积。治胸腹胀满，胸痹，痞痛，痰癖，水肿，食积，便秘，胃下垂，子宫下垂，脱肛。" />
          <attvalue for="8" value="苦；辛；寒①《本经》:味苦，寒。②《吴普" />
          <attvalue for="9" value="苦辛微寒" />
          <attvalue for="10" value="脾；胃；肝；心经①《雷公炮制药性解》:入心、脾二经。②《本草" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="脾胃虚弱及孕妇慎服，①《医学入门》:虚而久病，不可惧服。②《本草备要》:孕妇及气虚人忌用。③《得配本草》:大损真元，非邪实者，不可误用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:木香" label="herb:木香">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="木香" />
          <attvalue for="4" value="286" />
          <attvalue for="5" value="泻下药" />
          <attvalue for="6" value="行气止痛；调中导滞。主胞胁胀满足 ；脘腹胀痛；哎吐泄泻；痢疾后重。用于胸脘胀痛、泻痢后重、食积不消、不思饮食。①《本经》：主邪气，辟毒疫，强志，主淋露。②《别录》：疗气劣、肌中偏寒；主气不足，消毒，（" />
          <attvalue for="7" value="木香：行气止痛，温中和胃。治中寒气滞，胸腹胀痛，呕吐，泄泻，下痢里急后重，寒疝。" />
          <attvalue for="8" value="辛味辛；苦；性温。①《本经》：味辛，温。" />
          <attvalue for="9" value="辛苦温" />
          <attvalue for="10" value="入肺、肝、脾经。①《本草衍义补遗》：行肝经。②《雷公炮制药性" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴虚津液不足者慎服。①《本草经疏》：肺虚有热者，慎毋犯之。元气虚脱及阴虚内热，诸病有热，心痛属火者禁用。②《得配本草》：脏腑燥热，胃气虚弱者禁用。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:香附" label="herb:香附">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="香附" />
          <attvalue for="4" value="287" />
          <attvalue for="5" value="理气药" />
          <attvalue for="6" value="理气解郁；调经止痛；安胎。主胁肋胀痛；乳房胀育；疝气疼痛；月经不调；脘腹痞满疼痛；嗳气吞酸，呕恶；经行腹痛；崩漏带下；胎动不安。用于肝郁气滞，胸、胁、脘腹胀痛，消化不良，胸脘痞闷，寒疝腹痛，乳房胀痛，" />
          <attvalue for="7" value="香附：理气解郁，止痛调经。治肝胃不和，气郁不舒，胸腹胁肋胀痛，痰饮痞满，月经不调，崩漏带下。" />
          <attvalue for="8" value="味辛；微寒；无毒。①《别录》：味甘，微寒" />
          <attvalue for="9" value="辛微苦微甘平肝三焦" />
          <attvalue for="10" value="入肝、三焦经。①《纲目》：手足默阴、手少阳，兼行十二经、八脉" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="凡气虚无滞、阴虚血热者忌服，①《纲目》：得童子小便、醋、芎藭、苍术良。②《本草经疏》：凡月事先期者，血热也，法当凉血，禁用此药。③《本草汇言》：独用、多用、久用，耗气损血。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:乌药" label="herb:乌药">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="乌药" />
          <attvalue for="4" value="288" />
          <attvalue for="5" value="温里药" />
          <attvalue for="6" value="顺气，开郁，散寒，止痛。治气逆胸腹胀痛，宿食不消，反胃吐食，寒疝，脚气，小便频数。①《本草拾遗》：主中恶心腹痛，宿食不消，天行疫瘴，膀胱肾间冷气攻冲背膂，妇人血气，小儿腹中诸虫。②《日华子本草》：治一" />
          <attvalue for="7" value="乌药：顺气，开郁，散寒，止痛。治气逆胸腹胀痛，宿食不消，反胃吐食，寒疝，脚气，小便频数。" />
          <attvalue for="8" value="辛，温。①《开宝本草》：味辛，温，无毒。" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入脾、肺、肾、膀胱经。①《汤液本草》：入足阳明、少阴经。②《" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="气虚、内热者忌服。①《医学入门》：疏散宣通，甚于香附，不可多服。②《本草经疏》：病属气虚者忌之。妇人月事先期，小便短赤，及咳嗽内热，口渴，口干、舌苦，不得眠，一切阴虚内热之病，皆不宜服。③《本经逢源》：不可见火。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:沉香" label="herb:沉香">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="沉香" />
          <attvalue for="4" value="289" />
          <attvalue for="5" value="理气药" />
          <attvalue for="6" value="行气止痛；温中降逆；纳气平喘。主脘腹冷痛；气逆员息；胃寒呕吐呃逆；腰膝虚冷；大肠虚秘；小便气淋。用于胸腹气滞，胀闷作痛，手足逆冷，脐部疼痛，呕吐呃逆，气逆痰喘。①《别录》：疗风水毒肿，去恶气。②陶弘景" />
          <attvalue for="7" value="行气止痛，温中散寒，降逆平喘。用于胸腹气滞，胀闷作痛，手足逆冷，脐部疼痛，呕吐呃逆，气逆痰喘。" />
          <attvalue for="8" value="辛苦，温。①《别录》：微温。②《海药本草" />
          <attvalue for="9" value="辛、苦" />
          <attvalue for="10" value="入肾、脾、胃经。①《雷公炮制药性解》：肾、命门二经。②《本草" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="阴亏火旺，气虚下陷者慎服。①《本草经疏》：中气虚，气不归元者忌之；心经有实邪者忌之；非命门真火衰者，不宜入下焦药用。②《本草汇言》：阴虚气逆上者切忌。③《本经逢原》：气虚下陷人，不可多服。④《本草从新》：阴亏火旺者，切勿沾唇。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:檀香" label="herb:檀香">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="檀香" />
          <attvalue for="4" value="290" />
          <attvalue for="5" value="温里药" />
          <attvalue for="6" value="行气；散寒；止痛。主胸腹胀痛;霍乱吐泻;噎膈吐食；寒疝腹痛及肿毒。用于寒凝气滞，胸痛，腹痛，胃痛食少；冠心病，心绞痛。①陶弘警：消风肿。②《本草拾遗》：主心腹霍乱，中恶，杀虫。③《日华子本草》：治心痛" />
          <attvalue for="7" value="檀香：行气；散寒；止痛。主胸腹胀痛;霍乱吐泻;噎膈吐食；寒疝腹痛及肿毒。用于寒凝气滞，胸痛，腹痛，胃痛食少；冠心病，心绞痛。" />
          <attvalue for="8" value="味辛，温。①《日华子本草》：热，无毒。②" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入脾，胃、肺经。①《汤液本草》：入手太阴，足少阴、阳明经。②" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="①《本草汇言》：如阴虚火盛，有动血致嗽者，勿用之。" />
          <attvalue for="13" value="1 - 副本 (4).txt" />
        </attvalues>
      </node>
      <node id="herb:川楝子" label="herb:川楝子">
