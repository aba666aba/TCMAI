      <node id="herb:鸡骨草" label="herb:鸡骨草">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="鸡骨草" />
          <attvalue for="4" value="1124" />
          <attvalue for="5" value="民间草药" />
          <attvalue for="6" value="清热解毒，舒肝散瘀。治黄疸肝炎，胃痛，乳痈，瘰疬，跌打伤瘀血疼痛。①《南宁市药物志》：消炎解毒。治传染性肝炎，跌打驳骨。叶：捣绒敷乳疮。②《中国药植图鉴》：治风湿骨痛，跌打瘀血内伤；并作清凉解热药。③" />
          <attvalue for="7" value="鸡骨草：清热解毒，舒肝散瘀。治黄疸肝炎，胃痛，乳痈，瘰疬，跌打伤瘀血疼痛。" />
          <attvalue for="8" value="甘、苦；凉；无毒。①《南宁市药物志》：甘" />
          <attvalue for="9" value="甘、微苦" />
          <attvalue for="10" value="心；肺；肝；胃；肾经" />
          <attvalue for="11" value="煎服，15-30g" />
          <attvalue for="12" value="本品种子有毒，不能入药，用时必须把豆荚全部摘除。凡虚寒体弱者慎用。" />
          <attvalue for="13" value="V4系统扩充" />
        </attvalues>
      </node>
      <node id="herb:蛇舌草" label="herb:蛇舌草">
