      <node id="herb:蚕沙" label="herb:蚕沙">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="蚕沙" />
          <attvalue for="4" value="1054" />
          <attvalue for="5" value="祛风湿药-祛风寒湿" />
          <attvalue for="6" value="祛风除湿；和胃化浊；活血通经。主风湿痹痛；肢体不遂；风疹瘙痒；吐泻转筋；闭经；崩漏1.“主肠鸣，热中消渴，风痹，瘾疹。”《名医别录》2.“治消渴，症结，及妇人血崩，头风，风赤眼，去风除湿。”《本草纲目" />
          <attvalue for="7" value="蚕沙：祛风除湿；和胃化浊；活血通经。主风湿痹痛；肢体不遂；风疹瘙痒；吐泻转筋；闭经；崩漏" />
          <attvalue for="8" value="辛；温；无毒。①《别录》：味辛，微温。②" />
          <attvalue for="9" value="甘、辛" />
          <attvalue for="10" value="入脾、胃经。①《本草求真》：入肝、脾。②《本草便读》：入脾、" />
          <attvalue for="11" value="包煎，5-15g" />
          <attvalue for="12" value="血不养筋、手足不遂者禁服。" />
          <attvalue for="13" value="V4系统扩充" />
        </attvalues>
      </node>
