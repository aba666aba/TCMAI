      <node id="herb:刺猬皮" label="herb:刺猬皮">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="刺猬皮" />
          <attvalue for="4" value="1047" />
          <attvalue for="5" value="收涩药" />
          <attvalue for="6" value="化瘀止痛；收敛止血；涩精缩尿。主胃脘疼痛；反胃吐食；便血；肠风下血；痔漏；脱肛；遗精；遗尿。治反胃吐食，腹痛疝气，肠风痔漏，遗精。①《本经》：主五痔阴蚀下血，赤白五色血汁不止，阴肿痛引腰背，酒煮杀之。" />
          <attvalue for="7" value="刺猬皮：化瘀止痛；收敛止血；涩精缩尿。主胃脘疼痛；反胃吐食；便血；肠风下血；痔漏；脱肛；遗精；遗尿" />
          <attvalue for="8" value="味苦；涩；性平。①《本经》：味苦，平。②" />
          <attvalue for="9" value="苦、甘" />
          <attvalue for="10" value="胃；大肠；肾经。①《本草求真》：入肠、胃。②《本草撮要》：入" />
          <attvalue for="11" value="煎服，3-10g" />
          <attvalue for="12" value="孕妇忌服。①《本草经集注》：得酒良。畏桔梗、麦门冬。" />
          <attvalue for="13" value="《中药学》教材/《中国药典》" />
        </attvalues>
      </node>
      <node id="herb:香薷" label="herb:香薷">
        <attvalues>
          <attvalue for="0" value="Herb" />
          <attvalue for="1" value="香薷" />
          <attvalue for="4" value="1048" />
          <attvalue for="5" value="解表药-辛温解表" />
          <attvalue for="6" value="发汗解暑，和中结湿，行水消肿。主夏月外感风寒；内伤于湿；恶寒发热；头痛无汗；脘腹疼痛；呕吐腹泻；小便不利；水肿。用于暑湿感冒，恶寒发热，头痛无汗，腹痛吐泻，小便不利。①《别录》：主霍乱，腹痛吐下，散水" />
          <attvalue for="7" value="香薷：发汗解暑，和中结湿，行水消肿。主夏月外感风寒；内伤于湿；恶寒发热；头痛无汗；脘腹疼痛；呕吐腹泻；小便不利；水肿。用于暑湿感冒，恶寒发热，头痛无汗，腹痛吐泻，小便不利" />
          <attvalue for="8" value="味辛；性微温。①《别录》：味辛，微温。②" />
          <attvalue for="9" value="辛" />
          <attvalue for="10" value="入肺、胃经。①《雷公炮制药性解》：入肺、胃二经。②《本草经疏" />
          <attvalue for="11" value="煎服，3-10g" />
          <attvalue for="12" value="表虚者忌服。①《本草从新》：无表邪者戒之。②《得配本草》：火盛气虚，阴虚有热者禁用。" />
          <attvalue for="13" value="V4系统扩充" />
        </attvalues>
      </node>
