      <node id="patent:7．通 宣理肺丸" label="patent:7．通 宣理肺丸">
        <attvalues>
          <attvalue for="0" value="PatentMedicine" />
          <attvalue for="1" value="7．通 宣理肺丸" />
          <attvalue for="4" value="99" />
          <attvalue for="5" value="一、解表类中成药" />
          <attvalue for="17" value="紫苏、前胡、桔梗、杏仁、麻黄、甘草、陈皮、半夏、茯苓、枳壳、黄芩" />
          <attvalue for="19" value="辛温发散，宣肺止咳。" />
          <attvalue for="7" value="用于感冒及病毒引起的急性上呼吸道炎；流感与流感病毒引起的急性上呼吸道感染；急性支气管炎；小儿支气管肺炎。" />
          <attvalue for="11" value="肌内注射：一次40～80mg，一日3次。静脉滴注：一日400mg～640mg，一日2次（用相当于药液5倍量的5%葡萄糖水稀释）或遵医嘱。" />
          <attvalue for="12" value="本品在使用过程中如有发热、憋气现象应立即停止用药；一旦出现过敏性休克表现，立即采取相应的急救措施。药物性状改变时禁用。用药过程应定期检查血像，发现血小板减少应及时停药，并给予相应处理。本品忌与酸、碱性药物或含有亚硫酸氢钠、焦亚硫酸钠等抗氧剂的药物配伍。" />
        </attvalues>
      </node>
      <node id="patent:9. 双黄连注射液" label="patent:9. 双黄连注射液">
        <attvalues>
          <attvalue for="0" value="PatentMedicine" />
          <attvalue for="1" value="9. 双黄连注射液" />
          <attvalue for="4" value="100" />
          <attvalue for="5" value="一、解表类中成药" />
          <attvalue for="17" value="" />
          <attvalue for="19" value="" />
          <attvalue for="7" value="用于外感风热引起的发热、咳嗽、咽痛；病毒及细菌感染的上呼吸道感染、肺炎、扁桃体炎、咽炎等。" />
          <attvalue for="11" value="静脉注射：一次10～20ml，一日1～2次。静脉滴注：1ml/kg，加入生理盐水或5～10％葡萄糖溶液中。肌注：一次2～4ml，一日2次。" />
          <attvalue for="12" value="婴幼儿应采用肌注给药。儿童及成人应在肌注给药一小时后，确认无过敏反应后可改为静脉给药(同批号)。本品与pH值低于4.0的5%～10%葡萄糖注射液配伍时，易产生黄芩苷析出。建议在使用时与氯化钠注射液或pH值高于4.0的5%～10%葡萄糖注射液配伍。出现过敏反应，马上使用地塞米松磷酸钠注射液、非那根注射液等抗过敏药物及硫酸阿托品等解痉药物进行解救。发现药液变深或浑浊、有异物等禁止使用。与青霉素、头孢拉啶、地塞米松配伍后不溶性微粒分别增加2、23、94倍。" />
        </attvalues>
      </node>
      <node id="patent:10.  柴胡注射液" label="patent:10.  柴胡注射液">
        <attvalues>
          <attvalue for="0" value="PatentMedicine" />
          <attvalue for="1" value="10.  柴胡注射液" />
          <attvalue for="4" value="101" />
          <attvalue for="5" value="二、清热类中成药" />
          <attvalue for="17" value="" />
          <attvalue for="19" value="和解退热，疏肌解热，升举阳气。" />
          <attvalue for="7" value="用于流感、普通感冒、疟疾等；寒热往来，胸脘胁痛，头痛、目眩，口苦、耳鸣以及疟疾、痢疾、脱肛、月经不调、子宫下垂等症。" />
          <attvalue for="11" value="" />
          <attvalue for="12" value="对本药物有过敏或严重不良反应病史应禁用。有严重不良反应病史的患者应慎用。应在医师指导下应用本品。用药时间不宜过长。有药物过敏史或有过敏体质的患者应避免使用。" />
        </attvalues>
      </node>
